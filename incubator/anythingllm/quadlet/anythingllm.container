[Unit]
Description=AnythingLLM
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-anythingllm.target

[Container]
Image=docker.io/mintplexlabs/anythingllm:1.17.0@sha256:f26f30df46916b6e953e3a47ca98f48817726e3df635e62d4bfdd133292ecfff
Pull=missing
ContainerName=anythingllm
User=anythingllm:anythingllm
EnvironmentFile=%t/homelab/rendered/site.env
Network=anythingllm.network
Environment=STORAGE_DIR=/app/server/storage
Volume=anythingllm-data.volume:/app/server/storage:U
Volume=anythingllm-node-modules.volume:/app/server/node_modules:U
Volume=%h/.local/state/homelab/anythingllm/.env:/app/server/.env:Z
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
