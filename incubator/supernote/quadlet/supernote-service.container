[Unit]
Description=Supernote service
After=supernote-mariadb.container supernote-valkey.container
Requires=supernote-mariadb.container supernote-valkey.container
PartOf=homelab-supernote.target

[Container]
Image=docker.io/supernote/supernote-service:26.10.09@sha256:570018387243cec1fcbb1176dc8b878f063a7e55ba5d0b802cecf64a9588159e
Pull=missing
ContainerName=supernote-service
Network=supernote.network
Network=supernote-edge.network
EnvironmentFile=%t/homelab/rendered/site.env
Environment=MYSQL_DATABASE=supernotedb
Environment=MYSQL_USER=supernote
Environment=REDIS_HOST=supernote-valkey
Environment=REDIS_PORT=6379
Environment=DB_HOSTNAME=supernote-mariadb
Environment=HTTP_PORT=443
Environment=HTTPS_PORT=443
Secret=supernote-database-user-password,type=env,target=MYSQL_PASSWORD
Secret=supernote-valkey-password,type=env,target=REDIS_PASSWORD
Volume=supernote-data.volume:/home/supernote/data
Volume=supernote-recycle.volume:/home/supernote/recycle
Volume=supernote-logs-cloud.volume:/home/supernote/cloud/logs
Volume=supernote-logs-app.volume:/home/supernote/logs
Volume=supernote-logs-web.volume:/var/log/nginx:U
Volume=supernote-nginx-config.volume:/etc/nginx:U
Volume=supernote-nginx-state.volume:/var/lib/nginx:U
Volume=supernote-convert.volume:/home/supernote/convert
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
AddCapability=CHOWN
AddCapability=NET_BIND_SERVICE
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--arch=amd64 --image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
