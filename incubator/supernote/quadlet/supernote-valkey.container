[Unit]
Description=Supernote Valkey
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-supernote.target

[Container]
Image=docker.io/valkey/valkey:9.1.2@sha256:a91d34ab33975b1054e26f1bd9995b268f7e0c507b5ded7f3d181a1a25521630
Pull=missing
ContainerName=supernote-valkey
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
Network=supernote.network
Exec=valkey-server /usr/local/etc/valkey/valkey.conf
Secret=supernote-valkey-password,type=env,target=VALKEY_PASSWORD
Volume=%t/homelab/rendered/supernote/valkey.conf:/usr/local/etc/valkey/valkey.conf:ro,Z
Volume=supernote-valkey.volume:/data:U
HealthCmd=valkey-cli --no-auth-warning -a "$VALKEY_PASSWORD" ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=10s
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
