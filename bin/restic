#!/usr/bin/env bash
set -Eeuo pipefail
set +x
umask 077

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

root=$(repo_root)
require_command jq
require_command realpath
require_command sops
restic_binary=${HOMELAB_RESTIC_BIN:-/usr/bin/restic}
[[ -x $restic_binary ]] || die "restic is not installed at $restic_binary"
[[ $(realpath "$restic_binary") != "$(realpath "$0")" ]] || die "HOMELAB_RESTIC_BIN resolves to the wrapper itself"

secrets_file="$root/secrets/secrets.sops.yaml"
[[ -r $secrets_file ]] || die "missing encrypted secrets: $secrets_file"
secrets_json=$(sops --config "$root/.sops.yaml" \
  --decrypt --output-type json "$secrets_file")
apply_site_config "$secrets_json"

AWS_ACCESS_KEY_ID=$(jq -jer '.backup.s3_access_key_id' <<<"$secrets_json")
AWS_SECRET_ACCESS_KEY=$(jq -jer '.backup.s3_secret_access_key' <<<"$secrets_json")
RESTIC_PASSWORD=$(jq -jer '.backup.repository_password' <<<"$secrets_json")
[[ -n $AWS_ACCESS_KEY_ID ]] || die "backup S3 access key ID is empty"
[[ -n $AWS_SECRET_ACCESS_KEY ]] || die "backup S3 secret access key is empty"
[[ -n $RESTIC_PASSWORD ]] || die "restic repository password is empty"

RESTIC_REPOSITORY="s3:${BACKUP_S3_ENDPOINT}/${BACKUP_S3_BUCKET}${BACKUP_S3_PREFIX:+/${BACKUP_S3_PREFIX}}"
RESTIC_HOST="homelab-${BASE_DOMAIN}"
RESTIC_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/restic"
AWS_DEFAULT_REGION=$BACKUP_S3_REGION
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION
export RESTIC_REPOSITORY RESTIC_PASSWORD RESTIC_HOST RESTIC_CACHE_DIR
unset secrets_json

exec "$restic_binary" "$@"
