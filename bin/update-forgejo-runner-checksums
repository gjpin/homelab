#!/usr/bin/env bash
set -Eeuo pipefail

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
release_tag=${1:?usage: update-forgejo-runner-checksums vX.Y.Z}
[[ $release_tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { printf 'invalid Forgejo Runner release: %s\n' "$release_tag" >&2; exit 1; }
version=${release_tag#v}
tmp_dir=$(mktemp -d)
trap 'rm -rf -- "$tmp_dir"' EXIT

for arch in amd64 arm64; do
  filename="forgejo-runner-${version}-linux-${arch}"
  checksum_file="$tmp_dir/$arch.sha256"
  curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
    --output "$checksum_file" \
    "https://code.forgejo.org/forgejo/runner/releases/download/${release_tag}/${filename}.sha256"
  read -r checksum published_filename <"$checksum_file"
  [[ $checksum =~ ^[0-9a-f]{64}$ && $published_filename == "$filename" ]] || {
    printf 'invalid upstream checksum metadata for %s\n' "$filename" >&2
    exit 1
  }
  case "$arch" in
    amd64) amd64_checksum=$checksum ;;
    arm64) arm64_checksum=$checksum ;;
  esac
done

metadata="$root/config/host-tools.env"
updated=$(mktemp "$root/config/host-tools.env.XXXXXX")
awk -v tag="$release_tag" -v amd64="$amd64_checksum" -v arm64="$arm64_checksum" '
  /^FORGEJO_RUNNER_RELEASE_TAG=/ { print "FORGEJO_RUNNER_RELEASE_TAG=" tag; next }
  /^FORGEJO_RUNNER_AMD64_BINARY_SHA256=/ { print "FORGEJO_RUNNER_AMD64_BINARY_SHA256=" amd64; next }
  /^FORGEJO_RUNNER_ARM64_BINARY_SHA256=/ { print "FORGEJO_RUNNER_ARM64_BINARY_SHA256=" arm64; next }
  { print }
' "$metadata" >"$updated"
mv -fT "$updated" "$metadata"
