#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID} -eq 0 ]] || { printf 'Run this command as root.\n' >&2; exit 1; }

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=/dev/null
source "$root/bin/lib.sh"
# shellcheck source=/dev/null
source "$root/bin/lib-host-storage.sh"
[[ $(uname -s) == Linux ]] || die "unsupported operating system: $(uname -s); this deployment requires Linux"
# shellcheck disable=SC1091
source /etc/os-release
[[ ${ID:-} == fedora && ${VERSION_ID:-} =~ ^(44|45)$ ]] || \
  die "unsupported host distribution: bootstrap-host requires Fedora 44 or Fedora 45"
arch=$(host_arch)
runtime_user=homelab
runtime_home=/home/homelab
repo_url=
branch=main
firewalld_zone=public
git_key=
known_hosts=
host_age_key=
data_disk_mode=auto
data_disk=
format_data_disk=false

while (($#)); do
  case "$1" in
    --repo) repo_url=${2:?}; shift 2 ;;
    --branch) branch=${2:?}; shift 2 ;;
    --firewalld-zone) firewalld_zone=${2:?}; shift 2 ;;
    --git-key) git_key=${2:?}; shift 2 ;;
    --known-hosts) known_hosts=${2:?}; shift 2 ;;
    --host-age-key) host_age_key=${2:?}; shift 2 ;;
    --no-data-disk)
      [[ $data_disk_mode == auto ]] || die "conflicting data disk options"
      data_disk_mode=skip
      shift
      ;;
    --data-disk)
      [[ $data_disk_mode == auto ]] || die "conflicting data disk options"
      data_disk_mode=use
      data_disk=${2:?}
      shift 2
      ;;
    --format-data-disk)
      format_data_disk=true
      shift
      ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done
[[ -n $repo_url ]] || { printf '%s\n' '--repo is required' >&2; exit 1; }
if $format_data_disk; then
  [[ $data_disk_mode == use ]] || die "--format-data-disk requires --data-disk"
fi
if [[ $data_disk_mode == use ]]; then
  [[ $data_disk == /dev/* ]] || die "--data-disk must be an absolute /dev path"
fi
[[ -z $host_age_key || ( -f $host_age_key && -r $host_age_key ) ]] || {
  printf '%s\n' '--host-age-key must be a readable age identity backup' >&2
  exit 1
}
case "$repo_url" in
  git@*:*|ssh://*)
    [[ -n $git_key ]] || { printf '%s\n' '--git-key is required for an SSH repository' >&2; exit 1; }
    [[ -n $known_hosts ]] || { printf '%s\n' '--known-hosts is required for an SSH repository' >&2; exit 1; }
    [[ -f $git_key && -r $git_key ]] || { printf '%s\n' '--git-key must be a readable private key file' >&2; exit 1; }
    [[ -f $known_hosts && -r $known_hosts ]] || { printf '%s\n' '--known-hosts must be a readable file' >&2; exit 1; }
    ;;
esac

packages=(
  age
  ca-certificates
  container-selinux
  curl
  diffutils
  firewalld
  fuse-overlayfs
  gettext-envsubst
  gawk
  git
  iproute
  jq
  libselinux-utils
  openssh-clients
  passt
  podman
  policycoreutils
  python3
  restic
  ripgrep
  shadow-utils
  systemd
  tar
  util-linux
  xfsprogs
)
if [[ $arch == arm64 ]]; then
  packages+=(qemu-user-binfmt qemu-user-static-x86)
fi
if ! dnf install -y "${packages[@]}"; then
  if [[ $arch == arm64 ]]; then
    die "ARM64 bootstrap requires qemu-user-binfmt and qemu-user-static-x86; the required emulation packages could not be installed"
  fi
  exit 1
fi
require_command age
require_command age-keygen
require_command envsubst
require_command fuse-overlayfs
require_command newgidmap
require_command newuidmap
require_command pasta
require_command restic
require_rpm_version() {
  local package=$1 minimum=$2 actual lowest
  actual=$(rpm -q --queryformat '%{VERSION}\n' "$package") || \
    die "required Fedora package is not installed: $package"
  lowest=$(printf '%s\n%s\n' "$minimum" "$actual" | sort -V | sed -n '1p')
  [[ $lowest == "$minimum" ]] || \
    die "$package $actual is older than the required $minimum"
}
require_rpm_version age 1.3.0
require_rpm_version restic 0.19.1
require_command getenforce
require_command getsebool
require_command selinuxenabled
selinuxenabled || die "SELinux is disabled; enable it before bootstrapping this host"
[[ $(getenforce) == Enforcing ]] || die "SELinux must be enforcing before bootstrapping this host"
getsebool container_use_devices >/dev/null 2>&1 || \
  die "container_use_devices is unavailable after installing container-selinux"
setsebool -P container_use_devices off

if [[ $arch == arm64 ]]; then
  systemctl enable --now systemd-binfmt
  require_command qemu-x86_64-static
  binfmt_registration=/proc/sys/fs/binfmt_misc/qemu-x86_64
  [[ -r $binfmt_registration ]] || die "ARM64 bootstrap could not find the qemu-x86_64 binfmt registration"
  grep -q '^enabled$' "$binfmt_registration" || \
    die "ARM64 bootstrap found a disabled qemu-x86_64 binfmt registration"
fi

"$root/bin/install-sops" "$root/config/host-tools.env"
# The system updater is deliberately copied outside the mutable Git checkout;
# it reads only validated release metadata from the deployed current release.
install -d -m 0755 /usr/local/libexec
install -m 0755 "$root/bin/install-sops" /usr/local/libexec/homelab-install-sops
# Remove binaries from older revisions only after Fedora's packages and the
# checksum-verified SOPS RPM have installed successfully.
legacy_bin_dir=/usr/local/bin
rm -f -- \
  "$legacy_bin_dir/age" "$legacy_bin_dir/age-keygen" "$legacy_bin_dir/age-inspect" \
  "$legacy_bin_dir/restic" "$legacy_bin_dir/sops"
systemctl enable --now firewalld

if ss -H -ltn 'sport = :443' | grep -q .; then
  printf 'TCP port 443 is already in use; stop the existing listener first.\n' >&2
  exit 1
fi

if ! id "$runtime_user" >/dev/null 2>&1; then
  useradd --create-home --home-dir "$runtime_home" --shell /bin/bash "$runtime_user"
  passwd --lock "$runtime_user"
fi
ensure_subordinate_id_range() {
  local user=$1 option=$2 database=$3
  if ! awk -F: -v user="$user" \
    '$1 == user && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 >= 65536 { found=1 }
     END { exit(found ? 0 : 1) }' "$database"; then
    usermod "$option" 100000-165535 "$user"
  fi
  require_subordinate_id_range "$database" "$user"
}
ensure_subordinate_id_range "$runtime_user" --add-subuids /etc/subuid
ensure_subordinate_id_range "$runtime_user" --add-subgids /etc/subgid

HOMELAB_RUNTIME_HOME=$runtime_home
export HOMELAB_RUNTIME_HOME
homelab_storage_setup "$data_disk_mode" "$data_disk" "$format_data_disk" "$runtime_user"
loginctl enable-linger "$runtime_user"

install -d -m 0700 -o "$runtime_user" -g "$runtime_user" "$runtime_home/.ssh" "$runtime_home/.config/sops/age" "$runtime_home/git"
if [[ -n $git_key ]]; then
  install -m 0600 -o "$runtime_user" -g "$runtime_user" "$git_key" "$runtime_home/.ssh/id_ed25519"
fi
if [[ -n $known_hosts ]]; then
  install -m 0600 -o "$runtime_user" -g "$runtime_user" "$known_hosts" "$runtime_home/.ssh/known_hosts"
fi
if [[ -n $host_age_key ]]; then
  if [[ -e $runtime_home/.config/sops/age/keys.txt ]]; then
    cmp -s -- "$host_age_key" "$runtime_home/.config/sops/age/keys.txt" || {
      printf '%s\n' '--host-age-key differs from the existing host age identity; refusing to overwrite it' >&2
      exit 1
    }
  else
    install -m 0600 -o "$runtime_user" -g "$runtime_user" \
      "$host_age_key" "$runtime_home/.config/sops/age/keys.txt"
  fi
elif [[ ! -f $runtime_home/.config/sops/age/keys.txt ]]; then
  runuser -u "$runtime_user" -- env HOME="$runtime_home" age-keygen -pq -o "$runtime_home/.config/sops/age/keys.txt"
  chmod 0600 "$runtime_home/.config/sops/age/keys.txt"
fi
recipient=$(runuser -u "$runtime_user" -- env HOME="$runtime_home" \
  age-keygen -y "$runtime_home/.config/sops/age/keys.txt")
require_pq_age_recipient "host identity recipient" "$recipient"

git_ssh=
if [[ -n $git_key ]]; then
  git_ssh="ssh -i $runtime_home/.ssh/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$runtime_home/.ssh/known_hosts"
fi
if [[ -d $runtime_home/git/repository/.git ]]; then
  if [[ -n $git_ssh ]]; then
    runuser -u "$runtime_user" -- env HOME="$runtime_home" GIT_SSH_COMMAND="$git_ssh" \
      git -C "$runtime_home/git/repository" pull --ff-only origin "$branch"
  else
    runuser -u "$runtime_user" -- env HOME="$runtime_home" \
      git -C "$runtime_home/git/repository" pull --ff-only origin "$branch"
  fi
else
  if [[ -n $git_ssh ]]; then
    runuser -u "$runtime_user" -- env HOME="$runtime_home" GIT_SSH_COMMAND="$git_ssh" \
      git clone --branch "$branch" "$repo_url" "$runtime_home/git/repository"
  else
    runuser -u "$runtime_user" -- env HOME="$runtime_home" \
      git clone --branch "$branch" "$repo_url" "$runtime_home/git/repository"
  fi
fi

secrets_file="$runtime_home/git/repository/secrets/secrets.sops.yaml"
if [[ -r $secrets_file ]] && rg -q '^sops:' "$secrets_file"; then
  secrets_json=$(runuser -u "$runtime_user" -- env HOME="$runtime_home" \
    sops --decrypt --output-type json "$secrets_file")
  apply_site_config "$secrets_json"
  unset secrets_json
  timedatectl set-timezone "$TIMEZONE"
  device="/dev/serial/by-id/$HOMEASSISTANT_ZIGBEE_ROUTER_SERIAL_ID"
  [[ -e $device ]] || die "configured Zigbee coordinator does not exist: $device"
  device_group=$(stat -c %G "$device")
  usermod --append --groups "$device_group" "$runtime_user"
  loginctl terminate-user "$runtime_user" || true
else
  info "encrypted secrets are not present yet; re-run bootstrap-host after init-secrets to apply timezone and Zigbee access"
fi

install -m 0644 "$root/systemd/system/caddy-https-proxy.socket" /etc/systemd/system/caddy-https-proxy.socket
install -m 0644 "$root/systemd/system/caddy-https-proxy.service" /etc/systemd/system/caddy-https-proxy.service
install -m 0644 "$root/systemd/system/homelab-host-tools-update.service" /etc/systemd/system/homelab-host-tools-update.service
install -m 0644 "$root/systemd/system/homelab-host-tools-update.timer" /etc/systemd/system/homelab-host-tools-update.timer
systemctl daemon-reload
systemctl enable --now caddy-https-proxy.socket
systemctl enable --now homelab-host-tools-update.timer

firewall-cmd --permanent --zone "$firewalld_zone" --add-service=https
firewall-cmd --permanent --zone "$firewalld_zone" --add-port=22000/tcp
firewall-cmd --permanent --zone "$firewalld_zone" --add-port=22000/udp
firewall-cmd --reload

printf 'Host post-quantum age recipient: %s\n' "$recipient"
printf 'Add this recipient with the operator recipient using bin/init-secrets, commit, push, re-run bootstrap-host, then run:\n'
printf 'runuser -u %s -- env HOME=%s XDG_RUNTIME_DIR=/run/user/%s %s/git/repository/bin/reconcile\n' "$runtime_user" "$runtime_home" "$(id -u "$runtime_user")" "$runtime_home"
