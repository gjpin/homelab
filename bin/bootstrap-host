#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID} -eq 0 ]] || { printf 'Run this command as root.\n' >&2; exit 1; }

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=/dev/null
source "$root/bin/lib.sh"
# shellcheck source=/dev/null
source "$root/bin/lib-host-storage.sh"
# shellcheck source=/dev/null
source "$root/bin/lib-forgejo-runner-host.sh"
[[ $(uname -s) == Linux ]] || die "unsupported operating system: $(uname -s); this deployment requires Linux"
# shellcheck disable=SC1091
source /etc/os-release
[[ ${ID:-} == debian ]] || die "unsupported host distribution: bootstrap-host requires Debian"
arch=$(host_arch)
runtime_user=homelab
runtime_home=/home/homelab
repo_url=
branch=main
git_key=
known_hosts=
host_age_key=
data_disk_mode=auto
data_disk=
format_data_disk=false
defer_forgejo_runner=false

while (($#)); do
  case "$1" in
    --repo) repo_url=${2:?}; shift 2 ;;
    --branch) branch=${2:?}; shift 2 ;;
    --git-key) git_key=${2:?}; shift 2 ;;
    --known-hosts) known_hosts=${2:?}; shift 2 ;;
    --host-age-key) host_age_key=${2:?}; shift 2 ;;
    --no-data-disk)
      [[ $data_disk_mode == auto ]] || die "conflicting data disk options"
      data_disk_mode=skip
      shift
      ;;
    --data-disk)
      [[ $data_disk_mode == auto ]] || die "conflicting data disk options"
      data_disk_mode=use
      data_disk=${2:?}
      shift 2
      ;;
    --format-data-disk)
      format_data_disk=true
      shift
      ;;
    --defer-forgejo-runner)
      defer_forgejo_runner=true
      shift
      ;;
    --firewalld-zone) shift 2 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done
[[ -n $repo_url ]] || { printf '%s\n' '--repo is required' >&2; exit 1; }
if $format_data_disk; then
  [[ $data_disk_mode == use ]] || die "--format-data-disk requires --data-disk"
fi
if [[ $data_disk_mode == use ]]; then
  [[ $data_disk == /dev/* ]] || die "--data-disk must be an absolute /dev path"
fi
[[ -z $host_age_key || ( -f $host_age_key && -r $host_age_key ) ]] || {
  printf '%s\n' '--host-age-key must be a readable age identity backup' >&2
  exit 1
}
case "$repo_url" in
  git@*:*|ssh://*)
    [[ -n $git_key ]] || { printf '%s\n' '--git-key is required for an SSH repository' >&2; exit 1; }
    [[ -n $known_hosts ]] || { printf '%s\n' '--known-hosts is required for an SSH repository' >&2; exit 1; }
    [[ -f $git_key && -r $git_key ]] || { printf '%s\n' '--git-key must be a readable private key file' >&2; exit 1; }
    [[ -f $known_hosts && -r $known_hosts ]] || { printf '%s\n' '--known-hosts must be a readable file' >&2; exit 1; }
    ;;
esac

export DEBIAN_FRONTEND=noninteractive
apt-get update
packages=(
  apparmor
  bzip2
  ca-certificates
  curl
  dbus-user-session
  gawk
  gettext-base
  git
  iproute2
  jq
  nftables
  openssh-client
  python3
  python3-bcrypt
  ripgrep
  tar
  uidmap
  util-linux
  xfsprogs
)
if [[ $arch == arm64 ]]; then
  packages+=(qemu-user-static)
fi
apt-get install -y "${packages[@]}"
systemctl enable --now apparmor || true
aa_enabled=$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null || printf 'N')
[[ $aa_enabled == Y ]] || die "AppArmor is not enabled; enable it before bootstrapping this host"
require_command apparmor_parser

install -m 0755 -d /etc/apt/keyrings
curl --fail --location --proto '=https' --tlsv1.2 \
  --output /etc/apt/keyrings/docker.asc https://download.docker.com/linux/debian/gpg
chmod a+r /etc/apt/keyrings/docker.asc
codename=${VERSION_CODENAME:?}
dpkg_arch=$(dpkg --print-architecture)
printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian %s stable\n' \
  "$dpkg_arch" "$codename" >/etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin \
  docker-compose-plugin docker-ce-rootless-extras
systemctl enable --now docker.service
require_command docker

if [[ $arch == arm64 ]]; then
  systemctl enable --now systemd-binfmt || true
  require_command qemu-x86_64-static
fi

"$root/bin/install-age" "$root/config/host-tools.env"
"$root/bin/install-restic" "$root/config/host-tools.env"
"$root/bin/install-sops" "$root/config/host-tools.env"
"$root/bin/install-forgejo-runner" "$root/config/host-tools.env"
install -d -m 0755 /usr/local/lib/homelab
install -m 0755 "$root/bin/install-age" /usr/local/lib/homelab/install-age
install -m 0755 "$root/bin/install-restic" /usr/local/lib/homelab/install-restic
install -m 0755 "$root/bin/install-sops" /usr/local/lib/homelab/install-sops
install -m 0755 "$root/bin/install-forgejo-runner" /usr/local/lib/homelab/install-forgejo-runner

if ss -H -ltn 'sport = :443' | grep -q .; then
  printf 'TCP port 443 is already in use; stop the existing listener first.\n' >&2
  exit 1
fi

if ! id "$runtime_user" >/dev/null 2>&1; then
  useradd --create-home --home-dir "$runtime_home" --shell /bin/bash "$runtime_user"
fi
passwd --lock "$runtime_user"
usermod -aG docker "$runtime_user"

ensure_subordinate_id_range() {
  local user=$1 option=$2 database=$3 range=${4:-100000-165535}
  if ! awk -F: -v user="$user" \
    '$1 == user && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 >= 65536 { found=1 }
     END { exit(found ? 0 : 1) }' "$database"; then
    usermod "$option" "$range" "$user"
  fi
  require_subordinate_id_range "$database" "$user"
}

runner_user=forgejo-runner
runner_home=/home/forgejo-runner
if ! id "$runner_user" >/dev/null 2>&1; then
  useradd --create-home --home-dir "$runner_home" --shell /bin/bash "$runner_user"
fi
passwd --lock "$runner_user"
chmod 0700 "$runner_home"
ensure_subordinate_id_range "$runner_user" --add-subuids /etc/subuid 200000-265535
ensure_subordinate_id_range "$runner_user" --add-subgids /etc/subgid 200000-265535
require_matching_subordinate_id_ranges "$runner_user"
runner_groups=$(id -Gn "$runner_user")
for forbidden_group in wheel root adm sudo docker homelab; do
  [[ " $runner_groups " != *" $forbidden_group "* ]] || \
    die "$runner_user has forbidden group membership: $forbidden_group"
done
runner_uid=$(id -u "$runner_user")
forgejo_runner_configure_storage "$runner_user" "$runner_home"
forgejo_runner_configure_user_slice "$runner_uid"
loginctl enable-linger "$runner_user"
systemctl start "user@${runner_uid}.service"

HOMELAB_RUNTIME_HOME=$runtime_home
export HOMELAB_RUNTIME_HOME
homelab_storage_setup "$data_disk_mode" "$data_disk" "$format_data_disk" "$runtime_user"

install -d -m 0700 -o "$runtime_user" -g "$runtime_user" \
  "$runtime_home/.ssh" "$runtime_home/.config/sops/age" "$runtime_home/git" \
  "$runtime_home/.local/state/homelab"
chown "$runtime_user:$runtime_user" "$runtime_home/.config" "$runtime_home/.local" "$runtime_home/.local/state"
if [[ -n $git_key ]]; then
  install -m 0600 -o "$runtime_user" -g "$runtime_user" "$git_key" "$runtime_home/.ssh/id_ed25519"
fi
if [[ -n $known_hosts ]]; then
  install -m 0600 -o "$runtime_user" -g "$runtime_user" "$known_hosts" "$runtime_home/.ssh/known_hosts"
fi
if [[ -n $host_age_key ]]; then
  if [[ -e $runtime_home/.config/sops/age/keys.txt ]]; then
    cmp -s -- "$host_age_key" "$runtime_home/.config/sops/age/keys.txt" || {
      printf '%s\n' '--host-age-key differs from the existing host age identity; refusing to overwrite it' >&2
      exit 1
    }
  else
    install -m 0600 -o "$runtime_user" -g "$runtime_user" \
      "$host_age_key" "$runtime_home/.config/sops/age/keys.txt"
  fi
elif [[ ! -f $runtime_home/.config/sops/age/keys.txt ]]; then
  runuser -u "$runtime_user" -- env HOME="$runtime_home" age-keygen -pq -o "$runtime_home/.config/sops/age/keys.txt"
  chmod 0600 "$runtime_home/.config/sops/age/keys.txt"
fi
recipient=$(runuser -u "$runtime_user" -- env HOME="$runtime_home" \
  age-keygen -y "$runtime_home/.config/sops/age/keys.txt")
require_pq_age_recipient "host identity recipient" "$recipient"

git_ssh=
if [[ -n $git_key ]]; then
  git_ssh="ssh -i $runtime_home/.ssh/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$runtime_home/.ssh/known_hosts"
fi
if [[ -d $runtime_home/git/repository/.git ]]; then
  if [[ -n $git_ssh ]]; then
    runuser -u "$runtime_user" -- env HOME="$runtime_home" GIT_SSH_COMMAND="$git_ssh" \
      git -C "$runtime_home/git/repository" pull --ff-only origin "$branch"
  else
    runuser -u "$runtime_user" -- env HOME="$runtime_home" \
      git -C "$runtime_home/git/repository" pull --ff-only origin "$branch"
  fi
else
  if [[ -n $git_ssh ]]; then
    runuser -u "$runtime_user" -- env HOME="$runtime_home" GIT_SSH_COMMAND="$git_ssh" \
      git clone --branch "$branch" "$repo_url" "$runtime_home/git/repository"
  else
    runuser -u "$runtime_user" -- env HOME="$runtime_home" \
      git clone --branch "$branch" "$repo_url" "$runtime_home/git/repository"
  fi
fi

secrets_file="$runtime_home/git/repository/secrets/secrets.sops.yaml"
if [[ -r $secrets_file ]] && rg -q '^sops:' "$secrets_file"; then
  secrets_json=$(runuser -u "$runtime_user" -- env HOME="$runtime_home" \
    sops --config "$runtime_home/git/repository/.sops.yaml" \
      --decrypt --output-type json "$secrets_file")
  apply_site_config "$secrets_json"
  unset secrets_json
  timedatectl set-timezone "$TIMEZONE"
  device="/dev/serial/by-id/$HOMEASSISTANT_ZIGBEE_ROUTER_SERIAL_ID"
  [[ -e $device ]] || die "configured Zigbee coordinator does not exist: $device"
  "$root/bin/install-zigbee-udev" "$HOMEASSISTANT_ZIGBEE_ROUTER_SERIAL_ID" "$runtime_user"
else
  info "encrypted secrets are not present yet; re-run bootstrap-host after init-secrets to apply timezone and Zigbee access"
fi

for unit in \
  homelab-secrets.service homelab.service \
  homelab-reconcile.service homelab-reconcile.timer \
  homelab-backup.service homelab-backup.timer \
  homelab-host-tools-update.service homelab-host-tools-update.timer \
  homelab-forgejo-runner-egress.service \
  forgejo-runner.service forgejo-runner-prune.service forgejo-runner-prune.timer; do
  install -m 0644 "$root/systemd/system/$unit" "/etc/systemd/system/$unit"
done
systemctl daemon-reload
systemctl enable --now homelab-host-tools-update.timer
systemctl enable homelab.service homelab-reconcile.timer homelab-backup.timer

install -d -m 0755 /etc/nftables
cat >/etc/nftables.d/homelab-host.nft <<'EOF'
table inet homelab_host {
  chain input {
    type filter hook input priority 0; policy accept;
    tcp dport { 22, 443 } accept
    tcp dport 22000 accept
    udp dport 22000 accept
  }
}
EOF
systemctl enable --now nftables || true

if [[ -v BASE_DOMAIN && -n $BASE_DOMAIN ]]; then
  runner_egress_tmp=$(mktemp /etc/nftables/homelab-forgejo-runner-egress.nft.XXXXXX)
  forgejo_runner_render_egress \
    "$root/config/nftables/forgejo-runner-egress.nft" "$runner_egress_tmp" "git.$BASE_DOMAIN"
  mv -fT "$runner_egress_tmp" /etc/nftables/homelab-forgejo-runner-egress.nft
  systemctl enable homelab-forgejo-runner-egress.service
  systemctl restart homelab-forgejo-runner-egress.service
  nft list table inet homelab_runner_egress >/dev/null
fi

runner_config_dir="$runner_home/.config/forgejo-runner"
install -d -m 0700 -o "$runner_user" -g "$runner_user" "$runner_home/.config" "$runner_config_dir"
runuser -u "$runner_user" -- env HOME="$runner_home" XDG_RUNTIME_DIR="/run/user/$runner_uid" \
  dockerd-rootless-setuptool.sh install
runuser -u "$runner_user" -- env HOME="$runner_home" XDG_RUNTIME_DIR="/run/user/$runner_uid" \
  systemctl --user enable --now docker.service

if [[ -v FORGEJO_RUNNER_UUID && -n $FORGEJO_RUNNER_UUID && -v FORGEJO_RUNNER_SECRET && -n $FORGEJO_RUNNER_SECRET ]]; then
  export FORGEJO_RUNNER_UUID FORGEJO_RUNNER_SECRET BASE_DOMAIN
  runner_config_tmp=$(mktemp "$runner_config_dir/config.yaml.XXXXXX")
  # shellcheck disable=SC2016
  envsubst '${BASE_DOMAIN} ${FORGEJO_RUNNER_UUID} ${FORGEJO_RUNNER_SECRET}' \
    <"$root/config/templates/forgejo-runner/config.yaml" >"$runner_config_tmp"
  chown "$runner_user:$runner_user" "$runner_config_tmp"
  chmod 0600 "$runner_config_tmp"
  mv -fT "$runner_config_tmp" "$runner_config_dir/config.yaml"
fi

systemctl enable forgejo-runner-prune.timer
if $defer_forgejo_runner; then
  systemctl disable --now forgejo-runner.service forgejo-runner-prune.timer >/dev/null 2>&1 || true
  info "Forgejo Runner activation deferred until bootstrap is run without --defer-forgejo-runner"
else
  systemctl enable --now forgejo-runner.service forgejo-runner-prune.timer
fi

printf 'Host post-quantum age recipient: %s\n' "$recipient"
printf 'Add this recipient with the operator recipient using bin/init-secrets, commit, push, re-run bootstrap-host, then start homelab.service.\n'
