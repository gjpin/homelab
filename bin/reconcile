#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

require_command docker
require_command flock
require_command git
require_command jq
require_command rg
require_command tar

runtime_home=${HOME:?HOME is not set}
repo_dir=${HOMELAB_REPO_DIR:-$runtime_home/git/repository}
releases_dir=${HOMELAB_RELEASES_DIR:-$runtime_home/releases}
current_link=${HOMELAB_CURRENT_LINK:-$runtime_home/current}
state_dir=$(homelab_state_dir)
branch=${HOMELAB_GIT_BRANCH:-main}
lock_file="${HOMELAB_LOCK_FILE:-$state_dir/operation.lock}"
dry_run=false
[[ ${1:-} == --dry-run ]] && dry_run=true

install -d -m 0700 "$state_dir"
exec 9>"$lock_file"
flock --nonblock 9 || die "another reconciliation is running"
[[ -d $repo_dir/.git ]] || die "Git checkout not found: $repo_dir"
install -d -m 0700 "$releases_dir"

compose_up() {
  local app=$1
  HOMELAB_RELEASE_ROOT=$release homelab_compose "$app" up -d --remove-orphans --pull missing
}

compose_down() {
  local app=$1
  HOMELAB_RELEASE_ROOT=$release homelab_compose "$app" down --remove-orphans
}

build_custom_image() {
  local image=$1
  info "building localhost/homelab/$image"
  docker build --pull --file "$release/images/$image/Containerfile" \
    --tag "localhost/homelab/$image" "$release/images/$image"
}

workload_containers_running() {
  local app=$1 name
  while IFS= read -r name; do
    docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null | grep -qx true || return 1
  done < <(jq -r --arg app "$app" '.[$app].containers[]' "$current_link/manifests/applications.json")
}

info "fetching origin/$branch"
git -C "$repo_dir" fetch --prune origin "$branch"
target_commit=$(git -C "$repo_dir" rev-parse "origin/$branch")
deployed_commit=
[[ -r $state_dir/deployed-commit ]] && read -r deployed_commit <"$state_dir/deployed-commit"

if [[ -n $deployed_commit ]] && ! git -C "$repo_dir" merge-base --is-ancestor "$deployed_commit" "$target_commit"; then
  die "origin/$branch is not a fast-forward from deployed commit $deployed_commit"
fi
if [[ $target_commit == "$deployed_commit" && -e $current_link ]]; then
  info "already at $target_commit"
  "$current_link/bin/verify-host-security"
  HOMELAB_RELEASE_ROOT=$current_link "$current_link/bin/render-config"
  HOMELAB_RELEASE_ROOT=$current_link "$current_link/bin/ensure-networks" "$current_link"
  while IFS= read -r app; do
    if ! workload_containers_running "$app"; then
      info "repairing inactive $app"
      release=$current_link compose_up "$app"
    fi
  done < <(jq -r 'keys[]' "$current_link/manifests/applications.json")
  "$current_link/bin/security-audit"
  exit 0
fi

release="$releases_dir/$target_commit"
if [[ ! -d $release ]]; then
  install -d -m 0700 "$release"
  git -C "$repo_dir" archive "$target_commit" | tar -x -p -C "$release"
fi

"$release/bin/validate" --deployment
"$release/bin/fetch-assets"
"$release/bin/verify-host-security"

if $dry_run; then
  info "validated $target_commit; dry-run requested"
  exit 0
fi

export HOMELAB_RELEASE_ROOT=$release
while IFS= read -r image; do
  [[ -n $image ]] || continue
  build_custom_image "$image"
done < <(jq -r '.[] | select(.build != null) | .build' "$release/manifests/applications.json" | sort -u)

HOMELAB_OPERATION_LOCK_HELD=1 "$release/bin/migrate-databases" --release "$release"

apps=()
if [[ -z $deployed_commit ]]; then
  mapfile -t apps < <(jq -r 'keys[]' "$release/manifests/applications.json")
else
  mapfile -t changed_paths < <(git -C "$repo_dir" diff --name-only "$deployed_commit" "$target_commit")
  for path in "${changed_paths[@]}"; do
    case "$path" in
      compose/*)
        app=$(cut -d/ -f2 <<<"$path")
        [[ -d $release/compose/$app ]] && apps+=("$app")
        ;;
      config/templates/*)
        app=$(cut -d/ -f3 <<<"$path")
        [[ -d $release/compose/$app ]] && apps+=("$app")
        ;;
      images/caddy/*)
        apps+=(caddy)
        ;;
      manifests/networks.json)
        mapfile -t apps < <(jq -r 'keys[]' "$release/manifests/applications.json")
        break
        ;;
      secrets/*|.sops.yaml|bin/*|systemd/*|manifests/*)
        mapfile -t apps < <(jq -r 'keys[]' "$release/manifests/applications.json")
        break
        ;;
    esac
  done
fi
mapfile -t apps < <(printf '%s\n' "${apps[@]}" | sed '/^$/d' | sort -u)

previous_apps=()
if [[ -L $current_link && -r $current_link/manifests/applications.json ]]; then
  mapfile -t previous_apps < <(jq -r 'keys[]' "$current_link/manifests/applications.json")
fi
retired_apps=()
for previous_app in "${previous_apps[@]}"; do
  if ! jq -e --arg app "$previous_app" 'has($app)' "$release/manifests/applications.json" >/dev/null; then
    retired_apps+=("$previous_app")
    info "retiring $previous_app"
    HOMELAB_RELEASE_ROOT=$current_link compose_down "$previous_app" || true
  fi
done

previous_target=
[[ -L $current_link ]] && previous_target=$(readlink "$current_link")

restore_prior_release() {
  local message=$1 app
  if [[ -n $previous_target ]]; then
    ln -sfn "$previous_target" "$current_link"
    HOMELAB_RELEASE_ROOT=$previous_target "$previous_target/bin/render-config" || true
    HOMELAB_RELEASE_ROOT=$previous_target "$previous_target/bin/ensure-networks" "$previous_target" || true
    for app in "${previous_apps[@]}"; do
      HOMELAB_RELEASE_ROOT=$previous_target homelab_compose "$app" up -d --remove-orphans || true
    done
  fi
  die "$message"
}

ln -sfn "$release" "$current_link.next"
mv -Tf "$current_link.next" "$current_link"

"$release/bin/render-config"
"$release/bin/ensure-networks" "$release"

for app in "${apps[@]}"; do
  info "starting $app"
  compose_up "$app" || restore_prior_release "failed to start $app"
done

for app in "${apps[@]}"; do
  while IFS= read -r name; do
    docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null | grep -qx true || \
      restore_prior_release "$app container failed: $name. Named-volume major migrations already applied are not reversed."
  done < <(jq -r --arg app "$app" '.[$app].containers[]' "$release/manifests/applications.json")
done
"$release/bin/security-audit"
printf '%s\n' "$target_commit" >"$state_dir/deployed-commit"
info "deployed $target_commit"
