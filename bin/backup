#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

root=$(repo_root)
load_site_config "$root"
tag=manual
leave_stopped=false
while (($#)); do
  case "$1" in
    --tag) tag=${2:?}; shift 2 ;;
    --leave-stopped-on-success) leave_stopped=true; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done
[[ $tag =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "backup tag is invalid"

require_command docker
require_command flock
require_command jq
state_dir=$(homelab_state_dir)
lock_file="${HOMELAB_LOCK_FILE:-$state_dir/operation.lock}"
metadata_dir="$state_dir/backup-metadata"
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/homelab-backup.XXXXXX")
install -d -m 0700 "$state_dir"
exec 9>"$lock_file"
flock --nonblock 9 || die "another homelab maintenance operation is running"

apps=()
active_apps=()
deployment_stopped=false
snapshot_created=false
mapfile -t apps < <(jq -r 'keys[]' "$root/manifests/applications.json")

workload_is_up() {
  local app=$1 name
  while IFS= read -r name; do
    docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null | grep -qx true || return 1
  done < <(jq -r --arg app "$app" '.[$app].containers[]' "$root/manifests/applications.json")
}

start_apps() {
  local app rc=0
  for app in "${active_apps[@]}"; do
    homelab_compose "$app" up -d --remove-orphans || rc=1
  done
  return "$rc"
}

# Invoked by the EXIT trap below.
# shellcheck disable=SC2329
cleanup() {
  local rc=$? restart_rc
  rm -rf -- "$work_dir"
  if $deployment_stopped; then
    if $leave_stopped && $snapshot_created; then
      info "backup succeeded; applications remain stopped for migration"
    else
      set +e
      start_apps
      restart_rc=$?
      set -e
      if ((restart_rc != 0)); then
        printf 'error: failed to restart the deployment after backup\n' >&2
        ((rc == 0)) && rc=$restart_rc
      fi
    fi
  fi
  trap - EXIT
  exit "$rc"
}
trap cleanup EXIT

"$root/bin/restic" cat config >/dev/null
incomplete_marker="$state_dir/incomplete-backup-snapshot"
if [[ -s $incomplete_marker ]]; then
  read -r incomplete_snapshot <"$incomplete_marker"
  [[ $incomplete_snapshot =~ ^[0-9a-f]{64}$ ]] || die "invalid incomplete snapshot marker"
  info "removing previously recorded incomplete snapshot: $incomplete_snapshot"
  "$root/bin/restic" forget "$incomplete_snapshot"
  unlink "$incomplete_marker"
fi

mapfile -t expected_volumes < <(homelab_named_volumes "$root")
: >"$work_dir/actual-volumes"
for app in "${apps[@]}"; do
  docker volume ls --filter "label=homelab.application=$app" --format '{{.Name}}' >>"$work_dir/actual-volumes"
done
sort -u -o "$work_dir/actual-volumes" "$work_dir/actual-volumes"
printf '%s\n' "${expected_volumes[@]}" | sort >"$work_dir/expected-volumes"
diff -u "$work_dir/expected-volumes" "$work_dir/actual-volumes" || \
  die "declared and labeled Docker volume inventories differ"

: >"$work_dir/paths"
: >"$work_dir/volume-map.tsv"
while IFS= read -r volume; do
  mountpoint=$(docker volume inspect --format '{{.Mountpoint}}' "$volume")
  [[ -d $mountpoint ]] || die "volume mountpoint is unavailable: $volume"
  printf '%s\0' "$mountpoint" >>"$work_dir/paths"
  printf '%s\t%s\n' "$volume" "$mountpoint" >>"$work_dir/volume-map.tsv"
done <"$work_dir/expected-volumes"

required_paths=(
  "$HOME/.config/sops/age/keys.txt"
  "$state_dir/deployed-commit"
)
for path in "${required_paths[@]}"; do
  [[ -f $path ]] || die "required backup input is missing: $path"
done

for app in "${apps[@]}"; do
  if workload_is_up "$app"; then
    active_apps+=("$app")
  fi
done

deployment_stopped=true
for app in "${apps[@]}"; do
  homelab_compose "$app" stop >/dev/null || true
done
deadline=$((SECONDS + 60))
while [[ -n $(docker ps --filter label=com.docker.compose.project --quiet) ]]; do
  leftover=$(docker ps --filter label=com.docker.compose.project --format '{{.Names}}' || true)
  still=false
  for app in "${apps[@]}"; do
    while IFS= read -r name; do
      if grep -Fxq "$name" <<<"$leftover"; then
        still=true
      fi
    done < <(jq -r --arg app "$app" '.[$app].containers[]' "$root/manifests/applications.json")
  done
  $still || break
  if ((SECONDS >= deadline)); then
    printf 'still running:\n' >&2
    docker ps --format '{{.Names}}\t{{.Status}}' >&2 || true
    die "a container is still running; cold backup refused"
  fi
  sleep 1
done

install -d -m 0700 "$metadata_dir"
install -m 0600 "$work_dir/expected-volumes" "$metadata_dir/volume-list.txt"
install -m 0600 "$work_dir/volume-map.tsv" "$metadata_dir/volume-map.tsv"
printf '1\n' >"$metadata_dir/format-version"
printf '%s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" >"$metadata_dir/created-at"
for path in "${required_paths[@]}" "$metadata_dir"; do
  printf '%s\0' "$path" >>"$work_dir/paths"
done

info "creating incremental encrypted restic snapshot"
set +e
"$root/bin/restic" backup \
  --files-from-raw "$work_dir/paths" \
  --tag homelab --tag "$tag" --json | tee "$work_dir/restic-backup.json"
pipeline_status=("${PIPESTATUS[@]}")
set -e
snapshot_id=$(jq -r 'select(.message_type == "summary") | .snapshot_id // empty' \
  "$work_dir/restic-backup.json" | tail -n 1)
if ((pipeline_status[1] != 0)); then
  die "failed to record restic backup output"
fi
if ((pipeline_status[0] != 0)); then
  if [[ $snapshot_id =~ ^[0-9a-f]{64}$ ]]; then
    printf '%s\n' "$snapshot_id" >"$incomplete_marker"
    info "removing incomplete snapshot reported by restic: $snapshot_id"
    if "$root/bin/restic" forget "$snapshot_id"; then
      unlink "$incomplete_marker"
    fi
  fi
  die "restic backup failed with exit status ${pipeline_status[0]}"
fi
[[ $snapshot_id =~ ^[0-9a-f]{64}$ ]] || die "restic did not report a snapshot ID"
snapshot_created=true
printf '%s\n' "$snapshot_id" >"$state_dir/last-backup-snapshot"

if ! $leave_stopped; then
  start_apps
  deployment_stopped=false
fi

info "applying automatic snapshot retention"
"$root/bin/restic" forget --host "homelab-${BASE_DOMAIN}" --tag automatic \
  --keep-daily 2 --keep-weekly 4 --keep-monthly 2 --prune
"$root/bin/restic" check
{
  printf 'timestamp=%s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)"
  printf 'snapshot=%s\n' "$snapshot_id"
  printf 'tag=%s\n' "$tag"
} >"$state_dir/last-backup-success"
info "backup completed: $snapshot_id"

if $leave_stopped; then
  deployment_stopped=false
  info "applications remain stopped for migration"
fi
rm -rf -- "$work_dir"
trap - EXIT
exit 0
