#!/usr/bin/env python3
"""Create a Mosquitto 2.x SHA-512 PBKDF2 password-file record from stdin."""

import base64
import hashlib
import os
import sys


password = sys.stdin.buffer.read()
if not password:
    raise SystemExit("password cannot be empty")

salt = os.urandom(64)
iterations = 1000
digest = hashlib.pbkdf2_hmac("sha512", password, salt, iterations, dklen=64)
encoded_salt = base64.b64encode(salt).decode()
encoded_digest = base64.b64encode(digest).decode()
print(f"ha:$7${iterations}${encoded_salt}${encoded_digest}")
