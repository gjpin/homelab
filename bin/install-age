#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID} -eq 0 ]] || { printf 'Run this command as root.\n' >&2; exit 1; }

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '==> %s\n' "$*" >&2
}

host_arch() {
  case "$(uname -m)" in
    x86_64|amd64) printf '%s\n' amd64 ;;
    aarch64|arm64) printf '%s\n' arm64 ;;
    *) die "unsupported host architecture: $(uname -m) (supported architectures: amd64 and arm64)" ;;
  esac
}

config_file=${1:?usage: install-age HOST_TOOLS_METADATA}
[[ -r $config_file ]] || die "host tools metadata is not readable: $config_file"

release_tag=
amd64_tar_sha256=
arm64_tar_sha256=
while IFS= read -r line || [[ -n $line ]]; do
  [[ -z $line || $line == \#* ]] && continue
  [[ $line == *=* ]] || die "invalid host tools metadata line: $line"
  key=${line%%=*}
  value=${line#*=}
  case "$key" in
    AGE_RELEASE_TAG) [[ -z $release_tag ]] || die "duplicate host tools metadata key: $key"; release_tag=$value ;;
    AGE_AMD64_TAR_SHA256) [[ -z $amd64_tar_sha256 ]] || die "duplicate host tools metadata key: $key"; amd64_tar_sha256=$value ;;
    AGE_ARM64_TAR_SHA256) [[ -z $arm64_tar_sha256 ]] || die "duplicate host tools metadata key: $key"; arm64_tar_sha256=$value ;;
  esac
done <"$config_file"

[[ $release_tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "age release tag is invalid: $release_tag"
arch=$(host_arch)
case "$arch" in
  amd64) tar_sha256=$amd64_tar_sha256 ;;
  arm64) tar_sha256=$arm64_tar_sha256 ;;
esac
[[ $tar_sha256 =~ ^[0-9a-f]{64}$ ]] || die "host tools metadata contains an invalid SHA-256 checksum"
version=${release_tag#v}
archive="age-${release_tag}-linux-${arch}.tar.gz"
url="https://github.com/FiloSottile/age/releases/download/${release_tag}/${archive}"

for command in curl install sha256sum tar sort; do
  command -v "$command" >/dev/null 2>&1 || die "required command not found: $command"
done

workdir=$(mktemp -d)
trap 'rm -rf -- "$workdir"' EXIT
curl --fail --location --proto '=https' --tlsv1.2 --output "$workdir/$archive" "$url"
printf '%s  %s\n' "$tar_sha256" "$workdir/$archive" | sha256sum --check --status || \
  die "downloaded age archive checksum does not match the GitOps pin"
tar -xzf "$workdir/$archive" -C "$workdir"
[[ -x $workdir/age/age && -x $workdir/age/age-keygen ]] || die "age archive did not contain expected binaries"
candidate_version=$("$workdir/age/age" --version | awk '{print $NF}' | sed 's/^v//')
[[ $candidate_version == "$version" ]] || die "downloaded age version $candidate_version does not match expected $version"

if [[ -x /usr/local/bin/age ]]; then
  installed_version=$(/usr/local/bin/age --version | awk '{print $NF}' | sed 's/^v//')
  lowest=$(printf '%s\n%s\n' "$installed_version" "$version" | sort -V | sed -n '1p')
  [[ $lowest == "$installed_version" ]] || die "refusing to downgrade age from $installed_version to $version"
  if [[ $installed_version == "$version" ]]; then
    info "age $version is already installed"
    exit 0
  fi
  info "updating age from $installed_version to $version"
fi
install -d -m 0755 /usr/local/bin
install -m 0755 "$workdir/age/age" /usr/local/bin/age
install -m 0755 "$workdir/age/age-keygen" /usr/local/bin/age-keygen
info "installed age $version to /usr/local/bin/age"
