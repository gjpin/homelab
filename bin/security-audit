#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

root=$(repo_root)
require_command docker
require_command jq
"$root/bin/verify-host-security"

allowed_capability() {
  case "$1" in
    CAP_NET_BIND_SERVICE|CAP_CHOWN|CAP_DAC_OVERRIDE|CAP_FOWNER|CAP_SETGID|CAP_SETUID|CAP_SETPCAP) return 0 ;;
    *) return 1 ;;
  esac
}

while IFS= read -r name; do
  inspection=$(docker inspect "$name") || die "container is unavailable: $name"
  jq -e '.[0].State.Running == true' <<<"$inspection" >/dev/null || die "$name is not running"
  jq -e '.[0].HostConfig.ReadonlyRootfs == true' <<<"$inspection" >/dev/null || \
    die "$name does not have a read-only root filesystem"
  jq -e '((.[0].HostConfig.SecurityOpt // []) | map(ascii_downcase) | index("no-new-privileges:true")) != null' \
    <<<"$inspection" >/dev/null || die "$name does not enforce no-new-privileges"
  jq -e '.[0].HostConfig.PidsLimit > 0 and .[0].HostConfig.PidsLimit <= 1024' \
    <<<"$inspection" >/dev/null || die "$name has an invalid PID limit"
  jq -e '[.[0].Mounts[]? | select(.Type == "volume" and (.Name | startswith("homelab-") | not))] | length == 0' \
    <<<"$inspection" >/dev/null || die "$name has an untracked anonymous image volume"
  apparmor=$(jq -r '.[0].AppArmorProfile // ""' <<<"$inspection")
  [[ $apparmor == docker-default || $apparmor == */docker-default ]] || \
    die "$name is not confined by docker-default: $apparmor"
  while IFS= read -r capability; do
    [[ -n $capability ]] || continue
    allowed_capability "$capability" || die "$name has forbidden capability $capability"
  done < <(jq -r '.[0].HostConfig.CapAdd[]?' <<<"$inspection")
done < <(jq -r '.[] .containers[]' "$root/manifests/applications.json")

caddy_networks=$(docker inspect caddy | jq -r '.[0].NetworkSettings.Networks | keys[]')
for forbidden in homelab-forgejo homelab-homeassistant homelab-immich homelab-searxng; do
  if grep -Fxq "$forbidden" <<<"$caddy_networks"; then
    die "Caddy is attached to backend network $forbidden"
  fi
done

while IFS= read -r network; do
  internal=$(jq -r --arg n "$network" '.[$n].internal' "$root/manifests/networks.json")
  actual=$(docker network inspect -f '{{.Internal}}' "$network")
  expected=false
  [[ $internal == true ]] && expected=true
  [[ $actual == "$expected" ]] || die "network $network internal=$actual, expected $expected"
done < <(jq -r 'keys[]' "$root/manifests/networks.json")

for name in radicale syncthing vaultwarden; do
  while IFS= read -r network; do
    docker network inspect -f '{{.Internal}}' "$network" | grep -qx true || \
      die "$name has external access through non-internal network $network"
  done < <(docker inspect "$name" | jq -r '.[0].NetworkSettings.Networks | keys[]')
done

if [[ ${HOMELAB_SKIP_RUNNER_AUDIT:-} == 1 ]]; then
  info "runtime container security audit passed"
  exit 0
fi

runner_user=forgejo-runner
id "$runner_user" >/dev/null 2>&1 || die "$runner_user account is missing"
runner_groups=$(id -Gn "$runner_user")
for forbidden_group in wheel root adm sudo docker homelab; do
  [[ " $runner_groups " != *" $forbidden_group "* ]] || \
    die "$runner_user has forbidden group membership: $forbidden_group"
done
[[ -f /etc/nftables/homelab-forgejo-runner-egress.nft ]] || die "$runner_user egress policy is not installed"
systemctl is-active --quiet homelab-forgejo-runner-egress.service || die "$runner_user egress policy is not active"
pgrep -u "$(id -u "$runner_user")" -x forgejo-runner >/dev/null || \
  die "Forgejo Runner daemon is not running as $runner_user"

info "runtime container security audit passed"
