#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID} -eq 0 ]] || { printf 'Run this command as root.\n' >&2; exit 1; }

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '==> %s\n' "$*" >&2
}

host_arch() {
  case "$(uname -m)" in
    x86_64|amd64) printf '%s\n' amd64 ;;
    aarch64|arm64) printf '%s\n' arm64 ;;
    *) die "unsupported host architecture: $(uname -m) (supported architectures: amd64 and arm64)" ;;
  esac
}

config_file=${1:?usage: install-restic HOST_TOOLS_METADATA}
[[ -r $config_file ]] || die "host tools metadata is not readable: $config_file"

release_tag=
amd64_bz2_sha256=
arm64_bz2_sha256=
while IFS= read -r line || [[ -n $line ]]; do
  [[ -z $line || $line == \#* ]] && continue
  [[ $line == *=* ]] || die "invalid host tools metadata line: $line"
  key=${line%%=*}
  value=${line#*=}
  case "$key" in
    RESTIC_RELEASE_TAG) [[ -z $release_tag ]] || die "duplicate host tools metadata key: $key"; release_tag=$value ;;
    RESTIC_AMD64_BZ2_SHA256) [[ -z $amd64_bz2_sha256 ]] || die "duplicate host tools metadata key: $key"; amd64_bz2_sha256=$value ;;
    RESTIC_ARM64_BZ2_SHA256) [[ -z $arm64_bz2_sha256 ]] || die "duplicate host tools metadata key: $key"; arm64_bz2_sha256=$value ;;
  esac
done <"$config_file"

[[ $release_tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "restic release tag is invalid: $release_tag"
arch=$(host_arch)
case "$arch" in
  amd64) bz2_sha256=$amd64_bz2_sha256 ;;
  arm64) bz2_sha256=$arm64_bz2_sha256 ;;
esac
[[ $bz2_sha256 =~ ^[0-9a-f]{64}$ ]] || die "host tools metadata contains an invalid SHA-256 checksum"
version=${release_tag#v}
archive="restic_${version}_linux_${arch}.bz2"
url="https://github.com/restic/restic/releases/download/${release_tag}/${archive}"

for command in bunzip2 curl install sha256sum sort; do
  command -v "$command" >/dev/null 2>&1 || die "required command not found: $command"
done

install -d -m 0755 /usr/local/bin
workdir=$(mktemp -d)
trap 'rm -rf -- "$workdir"' EXIT
curl --fail --location --proto '=https' --tlsv1.2 --output "$workdir/$archive" "$url"
printf '%s  %s\n' "$bz2_sha256" "$workdir/$archive" | sha256sum --check --status || \
  die "downloaded restic archive checksum does not match the GitOps pin"
bunzip2 -c "$workdir/$archive" >"$workdir/restic"
chmod 0755 "$workdir/restic"
candidate_version=$("$workdir/restic" version | awk '{print $2}')
[[ $candidate_version == "$version" ]] || die "downloaded restic version $candidate_version does not match expected $version"

target_bin=/usr/local/bin/restic
if [[ -x $target_bin ]]; then
  installed_version=$("$target_bin" version | awk '{print $2}')
  lowest=$(printf '%s\n%s\n' "$installed_version" "$version" | sort -V | sed -n '1p')
  [[ $lowest == "$installed_version" ]] || die "refusing to downgrade restic from $installed_version to $version"
  if [[ $installed_version == "$version" ]]; then
    info "restic $version is already installed"
    exit 0
  fi
  info "updating restic from $installed_version to $version"
fi
mv -fT "$workdir/restic" "$target_bin"
chmod 0755 "$target_bin"
info "installed restic $version to $target_bin"
