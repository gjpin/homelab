#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID} -eq 0 ]] || { printf 'Run this command as root.\n' >&2; exit 1; }

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

arch=$(host_arch)

case "$arch" in
  amd64)
    release_tag=v0.19.1
    version=${release_tag#v}
    archive_sha256=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c
    archive="restic_${version}_linux_amd64.bz2"
    ;;
  arm64)
    release_tag=v0.19.1
    version=${release_tag#v}
    archive_sha256=a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465
    archive="restic_${version}_linux_arm64.bz2"
    ;;
esac
url="https://github.com/restic/restic/releases/download/v${version}/${archive}"
tmp_dir=$(mktemp -d)
trap 'rm -rf -- "$tmp_dir"' EXIT

curl --fail --location --proto '=https' --tlsv1.2 --output "$tmp_dir/$archive" "$url"
printf '%s  %s\n' "$archive_sha256" "$tmp_dir/$archive" | sha256sum --check --status
bzip2 --decompress "$tmp_dir/$archive"
install -m 0755 "$tmp_dir/${archive%.bz2}" /usr/local/bin/restic
/usr/local/bin/restic version
