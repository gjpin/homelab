#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

root=$(repo_root)
deployment=false
[[ ${1:-} == --deployment ]] && deployment=true

require_command jq
jq -e 'type == "object" and length == 8' "$root/manifests/applications.json" >/dev/null
jq -e 'type == "object" and length > 0' "$root/manifests/networks.json" >/dev/null

sops_age_line=$(sed -n 's/^[[:space:]]*age:[[:space:]]*//p' "$root/.sops.yaml")
[[ -n $sops_age_line && $sops_age_line != *$'\n'* ]] || die ".sops.yaml must contain exactly one age recipient rule"
IFS=, read -r -a sops_age_recipients <<<"$sops_age_line"
[[ ${#sops_age_recipients[@]} -eq 2 ]] || die ".sops.yaml must contain exactly two age recipients"
for recipient in "${sops_age_recipients[@]}"; do
  require_pq_age_recipient ".sops.yaml recipient" "$recipient"
done

if rg -n ':latest([@[:space:]]|$)|apparmor=unconfined' "$root/compose" "$root/config" "$root/images"; then
  die "floating latest tags or AppArmor disabled in compose"
fi

if rg -n --glob '!secrets.example.yaml' --glob '!*.sops.yaml' --glob '!docs/**' --glob '!tests/**' \
  '(API_KEY|PASSWORD|TOKEN|SECRET)[=:][^$[:space:]{][^[:space:]]+' "$root/compose" "$root/bin" "$root/config" "$root/systemd"; then
  die "possible plaintext secret found"
fi

while IFS= read -r app; do
  [[ -f $root/compose/$app/compose.yaml ]] || die "missing compose file for $app"
done < <(jq -r 'keys[]' "$root/manifests/applications.json")

if [[ -f $root/secrets/secrets.sops.yaml ]]; then
  rg -q '^sops:' "$root/secrets/secrets.sops.yaml" || die "secrets file is not SOPS encrypted"
  rg -q 'ENC\[' "$root/secrets/secrets.sops.yaml" || die "secrets file contains no encrypted values"
  mapfile -t encrypted_recipients < <(
    sed -n 's/^[[:space:]]*recipient:[[:space:]]*\(age[^[:space:]]*\)[[:space:]]*$/\1/p' \
      "$root/secrets/secrets.sops.yaml"
  )
  [[ ${#encrypted_recipients[@]} -eq 2 ]] || die "encrypted secrets must contain exactly two age recipients"
  for recipient in "${encrypted_recipients[@]}"; do
    require_pq_age_recipient "encrypted secrets recipient" "$recipient"
  done
elif $deployment; then
  die "secrets/secrets.sops.yaml has not been initialized"
fi

if $deployment; then
  load_site_config "$root"
fi

if command -v shellcheck >/dev/null 2>&1; then
  mapfile -t shell_scripts < <(rg -l '^#!/usr/bin/env bash$' "$root/bin" "$root/tests")
  shellcheck "${shell_scripts[@]}"
fi

info "validation passed"
