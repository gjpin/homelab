#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

printf '%-28s %s\n' UNIT STATE
for unit in homelab.service homelab-secrets.service homelab-reconcile.timer homelab-backup.timer \
  homelab-host-tools-update.timer homelab-forgejo-runner-egress.service; do
  printf '%-28s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
done

printf '\nContainers:\n'
docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'

printf '\nHost tools:\n'
printf '%-28s %s\n' 'sops version' "$(sops --version --disable-version-check 2>/dev/null || printf 'unavailable')"
printf '%-28s %s\n' 'age version' "$(age --version 2>/dev/null || printf 'unavailable')"
printf '%-28s %s\n' 'restic version' "$(restic version 2>/dev/null | awk '{print $1" "$2}' || printf 'unavailable')"
printf '%-28s %s\n' 'forgejo-runner version' "$(forgejo-runner --version 2>/dev/null || printf 'unavailable')"

printf '\nBackup:\n'
printf '%-28s %s\n' homelab-backup.timer "$(systemctl is-active homelab-backup.timer 2>/dev/null || true)"
next_run=$(systemctl show homelab-backup.timer --property=NextElapseUSecRealtime --value 2>/dev/null || true)
printf '%-28s %s\n' 'next run' "${next_run:-unknown}"
backup_result=$(systemctl show homelab-backup.service --property=Result --value 2>/dev/null || true)
printf '%-28s %s\n' 'last service result' "${backup_result:-unknown}"
state_dir=$(homelab_state_dir)
if [[ -r $state_dir/last-backup-success ]]; then
  sed 's/^/  /' "$state_dir/last-backup-success"
else
  printf '  no successful backup recorded\n'
fi
if [[ -s $state_dir/incomplete-backup-snapshot ]]; then
  printf '  WARNING incomplete snapshot: %s\n' \
    "$(<"$state_dir/incomplete-backup-snapshot")"
fi
