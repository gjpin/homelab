#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

require_command getenforce
require_command getsebool
require_command selinuxenabled
require_command fuse-overlayfs
require_command newgidmap
require_command newuidmap
require_command pasta
arch=$(host_arch)
runtime_user=$(id -un)
require_subordinate_id_range /etc/subuid "$runtime_user"
require_subordinate_id_range /etc/subgid "$runtime_user"

selinuxenabled || die "SELinux is disabled; refusing to start containers"
[[ $(getenforce) == Enforcing ]] || die "SELinux is not enforcing; refusing to start containers"

device_boolean=$(getsebool container_use_devices 2>/dev/null) || \
  die "container_use_devices is unavailable; verify that container-selinux is installed"
[[ $device_boolean == *' --> off' ]] || \
  die "container_use_devices must be off; Zigbee2MQTT uses the scoped container_device_t domain"

if [[ $arch == arm64 ]]; then
  require_command qemu-x86_64-static
  binfmt_registration=/proc/sys/fs/binfmt_misc/qemu-x86_64
  [[ -r $binfmt_registration ]] || \
    die "ARM64 host cannot run Supernote: qemu-x86_64 binfmt registration is unavailable"
  grep -q '^enabled$' "$binfmt_registration" || \
    die "ARM64 host cannot run Supernote: qemu-x86_64 binfmt registration is disabled"
fi

info "host container security prerequisites passed"
