#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

root=$(repo_root)
host_recipient=
operator_recipient=

while (($#)); do
  case "$1" in
    --host-recipient) host_recipient=${2:?}; shift 2 ;;
    --operator-recipient) operator_recipient=${2:?}; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

require_pq_age_recipient "--host-recipient" "$host_recipient"
require_pq_age_recipient "--operator-recipient" "$operator_recipient"
[[ $host_recipient != "$operator_recipient" ]] || die "host and operator recipients must be different"
require_command openssl
require_command python3
require_command sops
require_command argon2
python3 -c 'import bcrypt' 2>/dev/null || die "Python bcrypt module is required"

# Fail before prompting if this SOPS build predates built-in post-quantum age support.
printf '{}\n' | sops --age "$host_recipient,$operator_recipient" \
  --input-type json --output-type json --encrypt /dev/stdin >/dev/null

prompt_secret() {
  local label=$1 value confirm
  while true; do
    read -r -s -p "$label: " value </dev/tty
    printf '\n' >&2
    read -r -s -p "Confirm $label: " confirm </dev/tty
    printf '\n' >&2
    [[ -n $value ]] || { printf 'Value cannot be empty.\n' >&2; continue; }
    [[ $value == "$confirm" ]] || { printf 'Values did not match.\n' >&2; continue; }
    printf '%s' "$value"
    return
  done
}

prompt_confirmed() {
  local label=$1 allow_empty=${2:-false} value confirm
  while true; do
    read -r -p "$label: " value </dev/tty
    read -r -p "Confirm $label: " confirm </dev/tty
    [[ $value == "$confirm" ]] || { printf 'Values did not match.\n' >&2; continue; }
    if [[ $allow_empty != true && -z $value ]]; then
      printf 'Value cannot be empty.\n' >&2
      continue
    fi
    printf '%s' "$value"
    return
  done
}

bcrypt_hash() {
  python3 -c 'import bcrypt,sys; value=sys.stdin.buffer.read(); print(bcrypt.hashpw(value,bcrypt.gensalt(rounds=14)).decode())'
}

info "Enter private site identity, then operator-managed credentials; generated database credentials are random."
base_domain=$(prompt_confirmed 'Base domain')
timezone=$(prompt_confirmed 'Timezone (Area/Location)')
zigbee_serial=$(prompt_confirmed 'Home Assistant Zigbee router serial ID')
backup_s3_endpoint=$(prompt_confirmed 'Backup S3 endpoint (HTTPS origin)')
backup_s3_region=$(prompt_confirmed 'Backup S3 region')
backup_s3_bucket=$(prompt_confirmed 'Backup S3 bucket')
backup_s3_prefix=$(prompt_confirmed 'Backup S3 prefix (empty for bucket root)' true)
validate_base_domain "$base_domain"
validate_timezone "$timezone"
validate_zigbee_serial "$zigbee_serial"
validate_backup_s3_endpoint "$backup_s3_endpoint"
validate_backup_s3_region "$backup_s3_region"
validate_backup_s3_bucket "$backup_s3_bucket"
validate_backup_s3_prefix "$backup_s3_prefix"
backup_s3_access_key_id=$(prompt_secret 'Backup S3 access key ID')
backup_s3_secret_access_key=$(prompt_secret 'Backup S3 secret access key')
backup_repository_password=$(prompt_secret 'Restic repository password (store it in the operator password manager)')
[[ ${#backup_repository_password} -ge 20 ]] || die "restic repository password must contain at least 20 characters"
caddy_token=$(prompt_secret 'Cloudflare API token')
bookmarks_password=$(prompt_secret 'Bookmarks password')
read -r -p 'Radicale username [admin]: ' radicale_user </dev/tty
radicale_user=${radicale_user:-admin}
radicale_password=$(prompt_secret 'Radicale password')
vaultwarden_password=$(prompt_secret 'Vaultwarden admin password')

bookmarks_hash=$(printf '%s' "$bookmarks_password" | bcrypt_hash)
radicale_hash=$(printf '%s' "$radicale_password" | bcrypt_hash)
vaultwarden_hash=$(printf '%s' "$vaultwarden_password" | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4)
mosquitto_password=$(openssl rand -base64 36 | tr -d '\n')
forgejo_password=$(openssl rand -base64 36 | tr -d '\n')
immich_password=$(openssl rand -base64 36 | tr -d '\n')
supernote_root_password=$(openssl rand -base64 36 | tr -d '\n')
supernote_user_password=$(openssl rand -base64 36 | tr -d '\n')
supernote_valkey_password=$(openssl rand -base64 36 | tr -d '\n')
searxng_secret=$(openssl rand -hex 32)

recipients="$host_recipient,$operator_recipient"
tmp_sops=$(mktemp)
trap 'rm -f -- "$tmp_sops"' EXIT
cat >"$tmp_sops" <<EOF
creation_rules:
  - path_regex: ^secrets/.*\\.sops\\.yaml\$
    age: $recipients
EOF
chmod 0600 "$tmp_sops"

{
  printf '%s\0' \
    "$base_domain" "$timezone" "$zigbee_serial" \
    "$backup_s3_endpoint" "$backup_s3_region" "$backup_s3_bucket" "$backup_s3_prefix" \
    "$backup_s3_access_key_id" "$backup_s3_secret_access_key" \
    "$backup_repository_password" "$caddy_token" "$bookmarks_hash" \
    "$forgejo_password" "$mosquitto_password" "$immich_password" \
    "$radicale_user:$radicale_hash" "$searxng_secret" \
    "$supernote_root_password" "$supernote_user_password" \
    "$supernote_valkey_password" "$vaultwarden_hash"
} | python3 -c '
import json
import sys

values = sys.stdin.buffer.read().split(b"\0")
if values.pop() != b"" or len(values) != 21:
    raise SystemExit("invalid secret input")
(
    base_domain, timezone, zigbee_serial,
    backup_s3_endpoint, backup_s3_region, backup_s3_bucket, backup_s3_prefix,
    backup_s3_access_key_id, backup_s3_secret_access_key,
    backup_repository_password, caddy_token, bookmarks_hash,
    forgejo_password, mosquitto_password, immich_password, radicale_record,
    searxng_secret, supernote_root, supernote_user, supernote_valkey,
    vaultwarden_hash,
) = (value.decode() for value in values)
json.dump({
    "site": {
        "base_domain": base_domain,
        "timezone": timezone,
        "homeassistant_zigbee_router_serial_id": zigbee_serial,
    },
    "backup": {
        "s3_endpoint": backup_s3_endpoint,
        "s3_region": backup_s3_region,
        "s3_bucket": backup_s3_bucket,
        "s3_prefix": backup_s3_prefix,
        "s3_access_key_id": backup_s3_access_key_id,
        "s3_secret_access_key": backup_s3_secret_access_key,
        "repository_password": backup_repository_password,
    },
    "caddy": {
        "cloudflare_api_token": caddy_token,
        "bookmarks_password_hash": bookmarks_hash,
    },
    "forgejo": {"database_password": forgejo_password},
    "homeassistant": {"mosquitto_password": mosquitto_password},
    "immich": {"database_password": immich_password},
    "radicale": {"htpasswd_record": radicale_record},
    "searxng": {"secret_key": searxng_secret},
    "supernote": {
        "database_root_password": supernote_root,
        "database_user_password": supernote_user,
        "valkey_password": supernote_valkey,
    },
    "vaultwarden": {"admin_token_hash": vaultwarden_hash},
}, sys.stdout)
' |
  sops --config "$tmp_sops" --filename-override secrets/secrets.sops.yaml \
    --input-type json --output-type yaml --encrypt /dev/stdin >"$root/secrets/secrets.sops.yaml"

mv -f -- "$tmp_sops" "$root/.sops.yaml"
trap - EXIT
chmod 0600 "$root/secrets/secrets.sops.yaml"
unset base_domain timezone zigbee_serial
unset backup_s3_endpoint backup_s3_region backup_s3_bucket backup_s3_prefix
unset backup_s3_access_key_id backup_s3_secret_access_key backup_repository_password
unset caddy_token bookmarks_password bookmarks_hash
unset forgejo_password mosquitto_password immich_password radicale_password radicale_hash
unset searxng_secret supernote_root_password supernote_user_password supernote_valkey_password
unset vaultwarden_password vaultwarden_hash
info "Created .sops.yaml and encrypted secrets/secrets.sops.yaml"
