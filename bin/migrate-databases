#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# shellcheck source=/dev/null
source "$(dirname -- "$0")/lib.sh"

usage() {
  cat <<'EOF'
Usage: bin/migrate-databases [--release DIRECTORY] [--workload NAME] [--check] [--dry-run]

Detect PostgreSQL major upgrades from compose image tags versus on-disk PG_VERSION.
EOF
}

release=$(repo_root)
workload_filter=
check_only=false
dry_run=false

while (($#)); do
  case "$1" in
    --release) release=${2:?}; shift 2 ;;
    --workload) workload_filter=${2:?}; shift 2 ;;
    --engine)
      [[ ${2:?} == postgres ]] || die "unsupported engine: $2"
      shift 2
      ;;
    --check) check_only=true; shift ;;
    --dry-run) dry_run=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

require_command docker
require_command jq
require_command rg
require_command tar

[[ -d $release ]] || die "release directory does not exist: $release"
current_link=${HOMELAB_CURRENT_LINK:-$HOME/current}
state_dir=$(homelab_state_dir)
lock_file="${HOMELAB_LOCK_FILE:-$state_dir/operation.lock}"

if [[ ${HOMELAB_OPERATION_LOCK_HELD:-} != 1 ]]; then
  require_command flock
  install -d -m 0700 "$state_dir"
  exec 9>"$lock_file"
  flock --nonblock 9 || die "another homelab maintenance operation is running"
fi

extract_image_major_version() {
  local image=$1 output version
  output=$(docker run --rm --network none --cap-drop ALL --security-opt=no-new-privileges \
    --entrypoint postgres "$image" --version 2>/dev/null) || true
  version=$(sed -nE 's/.*PostgreSQL\) ([0-9]+).*/\1/p' <<<"$output")
  if [[ $version =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$version"
    return 0
  fi
  if [[ $image =~ :([0-9]+)(\.[0-9]+|-|@) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

read_on_disk_major() {
  local volume=$1 content
  docker volume inspect "$volume" >/dev/null 2>&1 || return 1
  content=$(docker run --rm --network none --volume "$volume:/data:ro" \
    docker.io/library/alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b \
    cat /data/PG_VERSION 2>/dev/null | tr -d '[:space:]') || return 1
  [[ $content =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$content"
}

volume_in_use() {
  local volume=$1
  [[ -n $(docker ps --filter "volume=$volume" --format '{{.Names}}' 2>/dev/null || true) ]]
}

compose_field() {
  local file=$1 container=$2 key=$3
  python3 - "$file" "$container" "$key" <<'PY'
import sys
path, container, key = sys.argv[1:]
text = open(path, encoding="utf-8").read().splitlines()
in_services = False
current = None
for line in text:
    if line.startswith("services:"):
        in_services = True
        continue
    if in_services and line and not line.startswith(" ") and not line.startswith("\t"):
        break
    if in_services and line.startswith("  ") and not line.startswith("    ") and line.strip().endswith(":"):
        current = line.strip()[:-1]
        continue
    if current is None:
        continue
    stripped = line.strip()
    if stripped.startswith("container_name:"):
        name = stripped.split(":", 1)[1].strip().strip('"')
        if name == container:
            wanted = current
            current_svc = None
            for line2 in text:
                if line2.startswith("services:"):
                    continue
                if line2.startswith("  ") and not line2.startswith("    ") and line2.strip().endswith(":"):
                    current_svc = line2.strip()[:-1]
                    continue
                if current_svc != wanted:
                    continue
                if line2.strip().startswith(key + ":"):
                    print(line2.split(":", 1)[1].strip().strip('"'))
                    raise SystemExit(0)
            raise SystemExit(1)
raise SystemExit(1)
PY
}

compose_env() {
  local file=$1 container=$2 key=$3
  python3 - "$file" "$container" "$key" <<'PY'
import sys
path, container, key = sys.argv[1:]
text = open(path, encoding="utf-8").read().splitlines()
wanted = None
current = None
in_env = False
for i, line in enumerate(text):
    if line.startswith("  ") and not line.startswith("    ") and line.strip().endswith(":"):
        current = line.strip()[:-1]
        in_env = False
        continue
    if current is None:
        continue
    if line.strip().startswith("container_name:"):
        name = line.split(":", 1)[1].strip().strip('"')
        if name == container:
            wanted = current
for current in [wanted]:
    if current is None:
        raise SystemExit(1)
in_svc = False
in_env = False
svc = None
for line in text:
    if line.startswith("  ") and not line.startswith("    ") and line.strip().endswith(":"):
        svc = line.strip()[:-1]
        in_env = False
        continue
    if svc != current:
        continue
    if line.strip() == "environment:":
        in_env = True
        continue
    if in_env:
        if line.startswith("    ") and ":" in line.strip():
            k, v = line.strip().split(":", 1)
            if k == key:
                print(v.strip().strip('"'))
                raise SystemExit(0)
        elif line.strip() and not line.startswith("    "):
            in_env = False
raise SystemExit(1)
PY
}

compose_named_volume() {
  local file=$1 suffix=$2
  rg -N "name: homelab-.*${suffix}$" "$file" | awk '{print $2}' | head -n 1
}

hardening=(--network none --read-only --cap-drop ALL --security-opt=no-new-privileges --pids-limit 1024)

migrations_needed=0
while IFS= read -r compose_file; do
  workload=$(basename "$(dirname "$compose_file")")
  [[ -z $workload_filter || $workload == "$workload_filter" ]] || continue
  container=$(rg -N 'container_name: .*-postgres$' "$compose_file" | awk '{print $2}' | head -n 1 || true)
  [[ -n $container ]] || continue
  target_image=$(compose_field "$compose_file" "$container" image) || die "missing image for $container"
  db_user=$(compose_env "$compose_file" "$container" POSTGRES_USER 2>/dev/null || printf '%s' "$workload")
  db_name=$(compose_env "$compose_file" "$container" POSTGRES_DB 2>/dev/null || printf '%s' "$workload")
  initdb_args=$(compose_env "$compose_file" "$container" POSTGRES_INITDB_ARGS 2>/dev/null || true)
  target_volume=$(compose_named_volume "$compose_file" postgres)
  [[ -n $target_volume ]] || die "missing postgres volume for $workload"
  config_volume=$(compose_named_volume "$compose_file" postgres-config || true)
  [[ $config_volume != "$target_volume" ]] || config_volume=

  docker volume inspect "$target_volume" >/dev/null 2>&1 || continue
  on_disk_version=$(read_on_disk_major "$target_volume") || continue
  target_version=$(extract_image_major_version "$target_image") || \
    die "could not determine PostgreSQL major version for $target_image"
  if ((on_disk_version == target_version)); then
    continue
  fi
  if ((on_disk_version > target_version)); then
    die "unsupported PostgreSQL downgrade from $on_disk_version to $target_version for $workload"
  fi
  migrations_needed=$((migrations_needed + 1))
  info "PostgreSQL major version migration detected for $workload: $on_disk_version -> $target_version"
  $check_only && continue

  old_image=
  if [[ -L $current_link && -f $current_link/compose/$workload/compose.yaml ]]; then
    candidate_image=$(compose_field "$current_link/compose/$workload/compose.yaml" "$container" image 2>/dev/null || true)
    candidate_version=$(extract_image_major_version "$candidate_image" 2>/dev/null || true)
    [[ $candidate_version == "$on_disk_version" ]] && old_image=$candidate_image
  fi
  if [[ -z $old_image ]]; then
    if [[ $target_image =~ ^ghcr\.io/immich-app/postgres: ]]; then
      old_image="ghcr.io/immich-app/postgres:${on_disk_version}"
    else
      old_image="docker.io/postgres:${on_disk_version}-bookworm"
    fi
  fi
  if $dry_run; then
    info "dry-run: would migrate $workload from PostgreSQL $on_disk_version to $target_version using $old_image -> $target_image"
    continue
  fi

  docker image inspect "$old_image" >/dev/null 2>&1 || docker pull "$old_image" >/dev/null
  homelab_compose "$workload" stop >/dev/null 2>&1 || true
  volume_in_use "$target_volume" && die "refusing to migrate $workload: volume $target_volume is still mounted"
  if [[ -n $config_volume ]]; then
    volume_in_use "$config_volume" && die "refusing to migrate $workload: volume $config_volume is still mounted"
  fi

  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/homelab-postgres-upgrade-${workload}.XXXXXX")
  backup_dir="$state_dir/postgres-upgrades"
  install -d -m 0700 "$backup_dir"
  timestamp=$(date +%Y%m%d%H%M%S)
  dump_archive="$backup_dir/${workload}-pg${on_disk_version}-to-pg${target_version}-${timestamp}.dump"
  raw_archive="$backup_dir/${workload}-postgres${on_disk_version}-raw-${timestamp}.tar"
  old_container="homelab-migrate-old-${workload}-$$"
  new_container="homelab-migrate-new-${workload}-$$"
  dump_file="$work_dir/dump"
  raw_backup_tar="$work_dir/raw.tar"

  # Invoked by the EXIT trap below.
  # shellcheck disable=SC2329
  cleanup() {
    local rc=$?
    set +e
    docker rm -f "$old_container" "$new_container" >/dev/null 2>&1 || true
    rm -rf -- "$work_dir"
    trap - EXIT
    exit "$rc"
  }
  trap cleanup EXIT

  volume_tar() {
    local volume=$1 dest=$2
    docker run --rm --network none --volume "$volume:/data:ro" --volume "$dest:/out" \
      docker.io/library/alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b \
      tar -C /data -cf /out/vol.tar .
  }
  volume_wipe() {
    local volume=$1
    docker run --rm --network none --volume "$volume:/data" \
      docker.io/library/alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b \
      sh -c 'find /data -mindepth 1 -delete'
  }
  volume_untar() {
    local volume=$1 archive=$2
    docker run --rm --network none --volume "$volume:/data" --volume "$archive:/in/vol.tar:ro" \
      docker.io/library/alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b \
      tar -C /data -xf /in/vol.tar
  }

  rollback_datadir() {
    docker rm -f "$old_container" "$new_container" >/dev/null 2>&1 || true
    volume_wipe "$target_volume"
    volume_untar "$target_volume" "$raw_archive"
  }

  env_file="$work_dir/pg.env"
  printf 'POSTGRES_USER=%s\nPOSTGRES_DB=%s\nPGDATA=/var/lib/postgresql/data\nPOSTGRES_HOST_AUTH_METHOD=trust\n' \
    "$db_user" "$db_name" >"$env_file"
  chmod 0600 "$env_file"
  docker run --detach --name "$old_container" "${hardening[@]}" \
    --tmpfs /tmp --tmpfs /run --tmpfs /var/run/postgresql \
    --env-file "$env_file" --volume "$target_volume:/var/lib/postgresql/data" \
    ${config_volume:+--volume "$config_volume:/etc/postgresql"} \
    "$old_image" >/dev/null

  ready=false
  for ((attempt = 1; attempt <= 90; attempt++)); do
    if docker exec "$old_container" pg_isready -h 127.0.0.1 -U "$db_user" -d "$db_name" >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 1
  done
  $ready || die "legacy PostgreSQL container did not become ready: $old_container"
  docker exec "$old_container" pg_dump -h 127.0.0.1 -U "$db_user" -d "$db_name" --format=custom --no-owner >"$dump_file"
  [[ -s $dump_file ]] || die "PostgreSQL dump for $workload is empty"
  docker rm -f "$old_container" >/dev/null
  volume_tar "$target_volume" "$work_dir"
  mv "$work_dir/vol.tar" "$raw_backup_tar"
  install -m 0600 "$dump_file" "$dump_archive"
  install -m 0600 "$raw_backup_tar" "$raw_archive"
  volume_wipe "$target_volume"
  [[ -n $config_volume ]] && volume_wipe "$config_volume"

  printf 'POSTGRES_USER=%s\nPOSTGRES_DB=%s\nPGDATA=/var/lib/postgresql/data\nPOSTGRES_HOST_AUTH_METHOD=trust\n' \
    "$db_user" "$db_name" >"$env_file"
  [[ -n $initdb_args ]] && printf 'POSTGRES_INITDB_ARGS=%s\n' "$initdb_args" >>"$env_file"
  docker run --detach --name "$new_container" "${hardening[@]}" \
    --tmpfs /tmp --tmpfs /run --tmpfs /var/run/postgresql \
    --env-file "$env_file" --volume "$target_volume:/var/lib/postgresql/data" \
    ${config_volume:+--volume "$config_volume:/etc/postgresql"} \
    "$target_image" >/dev/null
  ready=false
  for ((attempt = 1; attempt <= 90; attempt++)); do
    if docker exec "$new_container" pg_isready -h 127.0.0.1 -U "$db_user" -d "$db_name" >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 1
  done
  if ! $ready; then
    rollback_datadir
    die "new PostgreSQL container did not become ready: $new_container"
  fi
  docker cp "$dump_file" "$new_container:/tmp/migration.dump"
  if ! docker exec "$new_container" pg_restore -h 127.0.0.1 -U "$db_user" -d "$db_name" \
    --clean --if-exists --no-owner --exit-on-error /tmp/migration.dump; then
    rollback_datadir
    die "PostgreSQL restore failed for $workload; rollback completed"
  fi
  verified_db=$(docker exec "$new_container" psql -h 127.0.0.1 -U "$db_user" -d "$db_name" \
    --tuples-only --no-align --command='SELECT current_database()')
  if [[ $verified_db != "$db_name" ]]; then
    rollback_datadir
    die "database verification query failed for $workload"
  fi
  docker rm -f "$new_container" >/dev/null
  post_disk_version=$(read_on_disk_major "$target_volume") || post_disk_version=
  if [[ $post_disk_version != "$target_version" ]]; then
    rollback_datadir
    die "post-migration PostgreSQL version is $post_disk_version, expected $target_version"
  fi
  trap - EXIT
  rm -rf -- "$work_dir"
  info "migrated $workload PostgreSQL $on_disk_version -> $target_version"
done < <(find "$release/compose" -name compose.yaml -type f | sort)

if $check_only && ((migrations_needed > 0)); then
  exit 2
fi
exit 0
