FROM docker.io/caddy:2.11.7-builder-alpine@sha256:95a5e7e2692b5eb9545aadc5b90a39f6f509bee59c9508a493f83ee902eaef63 AS builder

RUN xcaddy build \
    --with github.com/mholt/caddy-webdav@fa2f366b0d75e54c2e381c0aefc3a8df8bf5794b \
    --with github.com/caddy-dns/cloudflare@v0.2.4

FROM docker.io/caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5

RUN addgroup -S -g 1000 caddy && \
    adduser -S -D -H -u 1000 -G caddy caddy

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
USER caddy:caddy
