FROM docker.io/caddy:2.11.4-builder-alpine@sha256:2b9f32cbba6045e79212bb253f595588d20be8f7d1edf61582c519e124e0d2d8 AS builder

RUN xcaddy build \
    --with github.com/mholt/caddy-webdav@fa2f366b0d75e54c2e381c0aefc3a8df8bf5794b \
    --with github.com/caddy-dns/cloudflare@v0.2.4

FROM docker.io/caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

RUN addgroup -S -g 1000 caddy && \
    adduser -S -D -H -u 1000 -G caddy caddy

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
USER caddy:caddy
