[Unit]
Description=Reconcile the homelab deployment from Git
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=homelab
Group=homelab
SupplementaryGroups=docker
Environment=HOME=/home/homelab
Environment=HOMELAB_STATE_DIR=/home/homelab/.local/state/homelab
ExecStart=/home/homelab/current/bin/reconcile
UMask=0077
