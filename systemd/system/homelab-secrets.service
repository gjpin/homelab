[Unit]
Description=Render homelab SOPS configuration
After=network-online.target
Wants=network-online.target
Before=homelab.service

[Service]
Type=oneshot
User=homelab
Group=homelab
Environment=HOME=/home/homelab
Environment=HOMELAB_STATE_DIR=/home/homelab/.local/state/homelab
ExecStart=/home/homelab/current/bin/render-config
RemainAfterExit=yes
UMask=0077
