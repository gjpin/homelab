# One-time, read-only migration images for the legacy Docker deployment.
# These are intentionally PostgreSQL 17 images because the legacy data
# directories must be dumped before they can be opened by the active
# PostgreSQL 18 Quadlets. Do not use these images for normal deployment.
LEGACY_FORGEJO_POSTGRES_IMAGE=docker.io/postgres:17.10-bookworm@sha256:9b18b78397054fce88a9552e9d5a3ad5bb7fd258c5b3cc1c5028e46373d6ea8f
LEGACY_IMMICH_POSTGRES_IMAGE=ghcr.io/immich-app/postgres:17-vectorchord1.1.1-pgvector0.8.5@sha256:3ea13db44f1116042032ec638979eae2dbd4f2419c7d2e134fbe308a534cb054
LEGACY_SUPERNOTE_MARIADB_IMAGE=docker.io/library/mariadb:11.8.3-noble@sha256:ae6119716edac6998ae85508431b3d2e666530ddf4e94c61a10710caec9b0f71
