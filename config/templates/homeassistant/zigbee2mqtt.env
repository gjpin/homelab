ZIGBEE2MQTT_CONFIG_PERMIT_JOIN=false
ZIGBEE2MQTT_CONFIG_MQTT_SERVER=mqtt://homeassistant-mosquitto:1883
ZIGBEE2MQTT_CONFIG_MQTT_BASE_TOPIC=zigbee2mqtt
ZIGBEE2MQTT_CONFIG_MQTT_USER=ha
ZIGBEE2MQTT_CONFIG_MQTT_KEEPALIVE=60
ZIGBEE2MQTT_CONFIG_MQTT_VERSION=5
ZIGBEE2MQTT_CONFIG_ADVANCED_CACHE_STATE=true
ZIGBEE2MQTT_CONFIG_ADVANCED_CACHE_STATE_PERSISTENT=true
ZIGBEE2MQTT_CONFIG_ADVANCED_CACHE_STATE_SEND_ON_STARTUP=true
ZIGBEE2MQTT_CONFIG_ADVANCED_OUTPUT=json
ZIGBEE2MQTT_CONFIG_FRONTEND_ENABLED=true
ZIGBEE2MQTT_CONFIG_FRONTEND_PACKAGE=zigbee2mqtt-frontend
ZIGBEE2MQTT_CONFIG_FRONTEND_PORT=8080
ZIGBEE2MQTT_CONFIG_FRONTEND_URL=https://home-zigbee.${BASE_DOMAIN}
ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_ENABLED=true
ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_DISCOVERY_TOPIC=homeassistant
ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_STATUS_TOPIC=homeassistant/status
ZIGBEE2MQTT_CONFIG_OTA_UPDATE_CHECK_INTERVAL=1440
ZIGBEE2MQTT_CONFIG_OTA_DISABLE_AUTOMATIC_UPDATE_CHECK=false
ZIGBEE2MQTT_CONFIG_SERIAL_PORT=/dev/ttyACM0
ZIGBEE2MQTT_CONFIG_SERIAL_ADAPTER=ember
