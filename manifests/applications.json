{
  "anythingllm": {
    "units": ["anythingllm.service"],
    "secrets": []
  },
  "caddy": {
    "units": ["caddy-build.service", "caddy.service"],
    "secrets": ["caddy-cloudflare-api-token", "caddy-bookmarks-password-hash"]
  },
  "docs-mcp": {
    "units": ["docs-mcp-worker.service", "docs-mcp-server.service", "docs-mcp-web.service"],
    "secrets": ["docs-mcp-openai-api-key", "docs-mcp-posthog-api-key"]
  },
  "forgejo": {
    "units": ["forgejo-postgres.service", "forgejo.service"],
    "secrets": ["forgejo-database-password"]
  },
  "homeassistant": {
    "units": ["homeassistant-mosquitto.service", "homeassistant-zigbee2mqtt.service", "homeassistant.service"],
    "secrets": ["homeassistant-mosquitto-password"]
  },
  "immich": {
    "units": ["immich-redis.service", "immich-postgres.service", "immich-machine-learning.service", "immich-server.service"],
    "secrets": ["immich-database-password"]
  },
  "radicale": {
    "units": ["radicale-build.service", "radicale.service"],
    "secrets": ["radicale-htpasswd-record"]
  },
  "searxng": {
    "units": ["searxng-valkey.service", "searxng-core.service"],
    "secrets": ["searxng-secret-key"]
  },
  "supernote": {
    "units": ["supernote-redis.service", "supernote-mariadb.service", "supernote-notelib.service", "supernote-service.service"],
    "secrets": ["supernote-database-root-password", "supernote-database-user-password", "supernote-redis-password"]
  },
  "syncthing": {
    "units": ["syncthing.service"],
    "secrets": []
  },
  "vaultwarden": {
    "units": ["vaultwarden.service"],
    "secrets": ["vaultwarden-admin-token"]
  }
}
