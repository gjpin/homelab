[Unit]
Description=SearXNG Valkey
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-searxng.target

[Container]
Image=docker.io/valkey/valkey:9.1.1@sha256:64e361b630ecf18dff7ca4df6a88e6eafc193687eb48cff2c7e0a293ab67d29a
Pull=missing
ContainerName=searxng-valkey
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
Network=searxng.network
Exec=valkey-server --save 30 1 --loglevel warning
Volume=searxng-valkey.volume:/data:U
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
