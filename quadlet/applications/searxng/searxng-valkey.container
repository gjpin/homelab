[Unit]
Description=SearXNG Valkey
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-searxng.target

[Container]
Image=docker.io/valkey/valkey:9.1.1@sha256:70739f85ad2ee01a726a965584a0f94895f01b0c60b3cc8b0aeef11eaa6888cf
Pull=missing
ContainerName=searxng-valkey
EnvironmentFile=%t/homelab/rendered/site.env
Network=searxng.network
Exec=valkey-server --save 30 1 --loglevel warning
Volume=searxng-valkey.volume:/data
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
AddCapability=CHOWN DAC_OVERRIDE FOWNER SETGID SETUID
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
