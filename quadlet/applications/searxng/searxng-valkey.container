[Unit]
Description=SearXNG Valkey
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-searxng.target

[Container]
Image=docker.io/valkey/valkey:9.1.2@sha256:475ee65cc75c327407458f5096cdd36954b3de3fc83f4c8ac31a4a8edecbf49e
Pull=missing
ContainerName=searxng-valkey
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
Network=searxng.network
Exec=valkey-server --save 30 1 --loglevel warning
Volume=searxng-valkey.volume:/data:U
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
