[Unit]
Description=Caddy reverse proxy
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-caddy.target

[Container]
Image=caddy.build
ContainerName=caddy
Network=anythingllm.network
Network=docs-mcp.network
Network=forgejo-edge.network
Network=homeassistant-edge.network
Network=immich-edge.network
Network=radicale.network
Network=searxng-edge.network
Network=supernote-edge.network
Network=syncthing.network
Network=vaultwarden.network
PublishPort=127.0.0.1:8443:443/tcp
EnvironmentFile=%t/homelab/rendered/site.env
Secret=caddy-cloudflare-api-token,type=env,target=CADDY_CLOUDFLARE_TOKEN
Secret=caddy-bookmarks-password-hash,type=env,target=CADDY_HASHED_PASSWORD
Volume=%h/current/config/templates/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=caddy-data.volume:/data/caddy
Volume=caddy-config.volume:/config/caddy
Volume=caddy-bookmarks.volume:/data/bookmarks
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
AddCapability=NET_BIND_SERVICE
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
