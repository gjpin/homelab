[Unit]
Description=Home Assistant Mosquitto
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-homeassistant.target

[Container]
Image=docker.io/library/eclipse-mosquitto:2.1.2-alpine@sha256:38c0da4f2ef84284d47b3b3eeea1cb3bdeabe81ee10caf0cd5c5ff61ee3ea408
Pull=missing
ContainerName=homeassistant-mosquitto
User=1883:1883
EnvironmentFile=%t/homelab/rendered/site.env
Network=homeassistant.network
Volume=%t/homelab/rendered/homeassistant/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro,Z
Volume=%t/homelab/rendered/homeassistant/mosquitto-passwords:/mosquitto/config/passwords:ro,Z
Volume=homeassistant-mosquitto-data.volume:/mosquitto/data:U
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
