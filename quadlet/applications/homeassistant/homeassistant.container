[Unit]
Description=Home Assistant
After=homelab-secrets.service
After=homeassistant-mosquitto.container
Requires=homelab-secrets.service
Requires=homeassistant-mosquitto.container
PartOf=homelab-homeassistant.target

[Container]
Image=ghcr.io/home-assistant/home-assistant:2026.8.3@sha256:14931c6b13756317849f46da1d01b45937a1150db66c081cfe529d48215943fe
Pull=missing
ContainerName=homeassistant
EnvironmentFile=%t/homelab/rendered/site.env
Network=homeassistant.network
Network=homeassistant-edge.network
Volume=homeassistant-config.volume:/config:U
Volume=%t/homelab/rendered/homeassistant/configuration.yaml:/config/configuration.yaml:ro,Z
Volume=%t/homelab/rendered/homeassistant/automations.yaml:/config/automations.yaml:ro,Z
Volume=/run/dbus:/run/dbus:ro
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
# s6-overlay must be PID 1. Set false explicitly so containers.conf init=true
# cannot inject catatonit (HA then exits 100).
RunInit=false

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
