[Unit]
Description=Forgejo PostgreSQL
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-forgejo.target

[Container]
Image=docker.io/postgres:18.6-bookworm@sha256:f1ea2a1a4fb7b68d4836be1fdcb8a6466a89b072158bf9d97663600538c294c5
Pull=missing
ContainerName=forgejo-postgres
User=postgres:postgres
EnvironmentFile=%t/homelab/rendered/site.env
Network=forgejo.network
Environment=POSTGRES_USER=forgejo
Environment=POSTGRES_DB=forgejo
Environment=PGDATA=/var/lib/postgresql/data
Secret=forgejo-database-password,type=env,target=POSTGRES_PASSWORD
Volume=forgejo-postgres.volume:/var/lib/postgresql/data:U
# Probe the network listener, not only the local socket.
HealthCmd=pg_isready -h forgejo-postgres -U forgejo -d forgejo
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=20s
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
