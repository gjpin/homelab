[Unit]
Description=Syncthing
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-syncthing.target

[Container]
Image=docker.io/syncthing/syncthing:2.1.5@sha256:397aa00b92b48d65540ea3ae3cbf271b87bdccbe07a0b7bd7d2debc3a7b29138
Pull=missing
ContainerName=syncthing
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
HostName=homelab
Network=syncthing.network
Environment=PUID=1000
Environment=PGID=1000
PublishPort=22000:22000/tcp
PublishPort=22000:22000/udp
Volume=syncthing-data.volume:/var/syncthing:U
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
