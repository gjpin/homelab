[Unit]
Description=Syncthing
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-syncthing.target

[Container]
Image=docker.io/syncthing/syncthing:2.1.6@sha256:4d0281bdcb4ed9baf503d251d0544ddd856f49fce3f114056257ae172b7fb670
Pull=missing
ContainerName=syncthing
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
HostName=homelab
Network=syncthing.network
Environment=PUID=1000
Environment=PGID=1000
PublishPort=22000:22000/tcp
PublishPort=22000:22000/udp
Volume=syncthing-data.volume:/var/syncthing:U
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
