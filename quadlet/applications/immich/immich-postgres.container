[Unit]
Description=Immich PostgreSQL
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-immich.target

[Container]
Image=ghcr.io/immich-app/postgres:18-vectorchord1.1.1-pgvector0.8.5@sha256:b427de4534e09120dd32cba873a2e88f9d026db7a0d813b226c5421c30669546
Pull=missing
ContainerName=immich-postgres
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
Network=immich.network
Environment=POSTGRES_USER=immich
Environment=POSTGRES_DB=immich
Environment=PGDATA=/var/lib/postgresql/data
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Secret=immich-database-password,type=env,target=POSTGRES_PASSWORD
Volume=immich-postgres.volume:/var/lib/postgresql/data:U
# The entrypoint copies its config template here only when the file is absent
# (cp -n), so this must be regenerated on every start rather than persisted.
Tmpfs=/etc/postgresql:rw,noexec,nosuid,nodev,mode=1777
# Probe the network listener: the local socket stays ready even when peers
# cannot connect (for example listen_addresses=localhost).
HealthCmd=pg_isready -h immich-postgres -U immich -d immich
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
