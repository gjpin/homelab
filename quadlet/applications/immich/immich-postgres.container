[Unit]
Description=Immich PostgreSQL
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-immich.target

[Container]
Image=ghcr.io/immich-app/postgres:18-vectorchord1.1.1-pgvector0.8.5@sha256:e53734de78ebf59a92261033c7dca61f789d925b79e7b68883f65b016cf27ed7
Pull=missing
ContainerName=immich-postgres
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
Network=immich.network
Environment=POSTGRES_USER=immich
Environment=POSTGRES_DB=immich
Environment=PGDATA=/var/lib/postgresql/data
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Secret=immich-database-password,type=env,target=POSTGRES_PASSWORD
Volume=immich-postgres.volume:/var/lib/postgresql/data:U
Volume=immich-postgres-config.volume:/etc/postgresql:U
HealthCmd=pg_isready -U immich -d immich
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
