[Unit]
Description=Immich Valkey
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-immich.target

[Container]
Image=docker.io/valkey/valkey:9.1.1@sha256:70739f85ad2ee01a726a965584a0f94895f01b0c60b3cc8b0aeef11eaa6888cf
Pull=missing
ContainerName=immich-valkey
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
Network=immich.network
Volume=immich-valkey.volume:/data:U
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
