[Unit]
Description=Immich Valkey
After=homelab-secrets.service
Requires=homelab-secrets.service
PartOf=homelab-immich.target

[Container]
Image=docker.io/valkey/valkey:9.2.1@sha256:169567d6288e5f08aa141847c0c3e0864a32e727682ca6f052a20567c7103ef8
Pull=missing
ContainerName=immich-valkey
User=1000:1000
EnvironmentFile=%t/homelab/rendered/site.env
Network=immich.network
Volume=immich-valkey.volume:/data:U
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=10
Notify=healthy
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
PodmanArgs=--image-volume=ignore
PidsLimit=1024
RunInit=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
